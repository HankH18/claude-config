#!/usr/bin/env bash
# claude-build — open a Claude Code session preconfigured for a swarm-loop run.
#
# Solves the failure that makes every other guard-fix moot: Claude Code reads
# .claude/settings.local.json at SESSION START. A settings file created mid-session
# is never picked up (measured on 2.1.252), so a run that installs its own git-guard
# after launching has no guard at all for the first mutating wave. This script writes
# the file, PROVES the hook is live, and only then launches the session.
#
# Everything it writes is recorded in .claude/.claude-build.json, so --uninstall
# removes exactly what was added and nothing you added yourself.
#
# Usage:  claude-build [DIR] [options]        Run with --help for options.

set -euo pipefail

SELF="${BASH_SOURCE[0]}"

# The skill is normally the installed one. But this script LIVES in the skill's
# bin/, so if the copy you invoked has a guard and a harness beside it, that is
# the copy you meant — a clone, a worktree, a checkout under review. Resolving
# it this way is what lets the suite exercise the launcher it is sitting next to
# instead of whatever happens to be in $HOME, and it never widens anything: the
# guard used is always the one belonging to the launcher you actually ran. A
# symlinked launcher resolves to the link's directory, fails the sibling test,
# and falls back to $HOME, which is correct.
SKILL="$HOME/.claude/skills/swarm-loop"
SELF_SKILL="$(cd "$(dirname "$SELF")/.." 2>/dev/null && pwd -P || true)"
if [ -n "$SELF_SKILL" ] \
   && [ -f "$SELF_SKILL/hooks/git-guard.py" ] \
   && [ -f "$SELF_SKILL/scripts/swarmloop.py" ]; then
  SKILL="$SELF_SKILL"
fi
GUARD="$SKILL/hooks/git-guard.py"
HARNESS="$SKILL/scripts/swarmloop.py"

DIR="" ; SPEC="" ; AUDIT_LOOPS="" ; MAX_CYCLES=""
LAUNCH=1 ; IN_TREE=0 ; DRY=0 ; QUIET=0 ; MODE=install ; PURGE=0

# Session topology. MODE says what claude-build DOES to a project (install /
# uninstall); WATCH says how many SESSIONS the run gets. They are orthogonal,
# so they get separate variables — "" | watch | watch-fix | full-auto.
WATCH="" ; AUTHORITY=0 ; CTO_ROLE=""

# The one-line sentinel that says hooks/git-guard.py has grown the authorization
# gate full-auto is built on. Until that string appears in the guard, full-auto
# REFUSES; see the full-auto block below and references/watch-sessions.md.
GATE_SENTINEL="CLAUDE_BUILD_AUTHORIZATION_GATE"

# Where per-run scaffolding lives. Defined with the other constants rather than
# beside its first use, because `--sessions` reads it long before the install
# flow that used to define it.
RUNS="$HOME/claude-build/runs"            # per-run scaffolding, not a document

die()  { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }
ok()   { [ "$QUIET" = 1 ] || printf '  \033[32m✓\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*" >&2; }
step() { [ "$QUIET" = 1 ] || printf '\n\033[1m%s\033[0m\n' "$*"; }

# --spec / --audit-loops / --max-cycles used to read "${2:-}" and then `shift 2`.
# With the flag last on the line $# is 1, `shift 2` fails, and under
# `set -euo pipefail` the script died at exit 1 with NO OUTPUT AT ALL. A
# launcher that dies without saying why is the same silent-verdict failure this
# skill keeps finding elsewhere. Every value-taking flag goes through here.
need_val() {  # need_val <flag> <remaining-argc> <next-word>
  [ "$2" -ge 2 ] && [ -n "$3" ] \
    || die "$1 needs a value — nothing followed it. (claude-build --help)"
  case "$3" in
    -*) die "$1 needs a value, but the next word is the option '$3'. (claude-build --help)" ;;
  esac
}
num_val() {  # num_val <flag> <value>   — a positive whole number, or a loud death
  case "$2" in
    *[!0-9]*) die "$1 wants a positive whole number, got '$2'" ;;
  esac
  [ "$2" -ge 1 ] || die "$1 wants a positive whole number, got '$2'"
}

# macOS ships bash 3.2, whose parser scans a heredoc body for quotes when the
# heredoc sits inside $( ... ) — one apostrophe in a Python comment then breaks
# the whole script. Define these at top level and pass them with -c instead.
read -r -d '' PY_MERGE <<'PY_MERGE_EOF' || true
import json, os, sys

path, wt, dry = os.environ["SETTINGS"], os.environ["WT"], os.environ["DRY"] == "1"
manifest_p = os.environ["MANIFEST"]
cmd = 'python3 "$HOME/.claude/skills/swarm-loop/hooks/git-guard.py"'

data, note = {}, []
if os.path.exists(path):
    try:
        with open(path) as f:
            data = json.load(f) or {}
        note.append("merged into existing settings.local.json")
    except Exception as e:
        print(f"FATAL:existing {path} is not valid JSON ({e}) — fix or move it first")
        sys.exit(3)
else:
    note.append("created settings.local.json")

# The manifest is the ONLY record of what uninstall has to undo. It used to be
# rebuilt from scratch and written unconditionally, so a SECOND install erased
# the first one's record: uninstall then no longer knew it had added
# Read(.env)/Edit(.env) or the worktree grant, and left them behind forever.
# Load the previous manifest and MERGE into it instead of overwriting.
prev = {}
if os.path.exists(manifest_p):
    try:
        with open(manifest_p) as f:
            prev = json.load(f) or {}
        note.append("merged into existing install manifest")
    except Exception:
        note.append("existing manifest unreadable — starting a fresh one")
        prev = {}

man = dict(prev)
man["permissions_added"] = list(prev.get("permissions_added") or [])
man["additional_directories_added"] = list(prev.get("additional_directories_added") or [])
man["gitignore_added"] = list(prev.get("gitignore_added") or [])
man.setdefault("set_disable_all_hooks", False)
if prev.get("worktree_dir") and prev["worktree_dir"] != wt:
    note.append("worktree dir changed (%s -> %s); --purge only removes the new one"
                % (prev["worktree_dir"], wt))
man["worktree_dir"] = wt

# Hook entries MERGE across settings levels, so this never removes a user-level
# hook. disableAllHooks is the one switch that turns the guard off; pin it false.
#
# A user's own "disableAllHooks": true used to be flipped to false and only
# NOTED — set_disable_all_hooks stayed False, so the restore in --uninstall
# never fired and our flip was permanent. Record the prior state so uninstall
# can put it back. Record it ONCE: only the FIRST install sees the user's real
# value; every later one sees nothing but our own pin.
had_dah = "disableAllHooks" in data
if "disable_all_hooks_was_present" not in prev:
    man["disable_all_hooks_was_present"] = had_dah
    man["disable_all_hooks_prev"] = data.get("disableAllHooks")
    man["set_disable_all_hooks"] = not had_dah  # legacy field; older uninstallers read it
if had_dah and data.get("disableAllHooks") is True:
    note.append("flipped disableAllHooks true -> false (uninstall restores it)")
data["disableAllHooks"] = False

hooks = data.setdefault("hooks", {})
pre = hooks.setdefault("PreToolUse", [])
if not isinstance(pre, list):
    print("FATAL:hooks.PreToolUse is not a list — fix settings.local.json by hand")
    sys.exit(3)

def has_guard(entries):
    for e in entries:
        if isinstance(e, dict):
            for h in e.get("hooks") or []:
                if isinstance(h, dict) and "git-guard.py" in str(h.get("command", "")):
                    return True
    return False

if has_guard(pre):
    note.append("git-guard hook already present (left as-is)")
else:
    pre.append({"matcher": "Bash|Edit|Write|NotebookEdit|MultiEdit", "hooks": [{"type": "command", "command": cmd}]})
    note.append("added git-guard PreToolUse hook")

perms = data.setdefault("permissions", {})
adds = perms.get("additionalDirectories")
if not isinstance(adds, list):
    adds = []
if wt not in adds and not wt.startswith(os.path.dirname(os.path.dirname(path))+os.sep+".claude"):
    adds.append(wt)
    if wt not in man["additional_directories_added"]:  # union — see manifest note above
        man["additional_directories_added"].append(wt)
    note.append("granted worktree directory")
perms["additionalDirectories"] = adds

# Baseline allowlist: capability the swarm needs to not hang on a prompt, and
# nothing deploy-adjacent. Add project-specific Bash patterns yourself — a
# permission entry never widens a task packet's boundary.
baseline = [
    "Bash(git worktree add:*)", "Bash(git worktree list:*)", "Bash(git worktree prune:*)",
    "Bash(git merge:*)", "Bash(git branch:*)", "Bash(git commit:*)", "Bash(git add:*)",
    "Read(.env)", "Read(.env.*)", "Edit(.env)", "Edit(.env.*)",
]
allow = perms.get("allow")
if not isinstance(allow, list):
    allow = []
added = [p for p in baseline if p not in allow]
allow.extend(added)
# Union, never replace: on a second install `added` is empty because the first
# install already put these in allow[], and assigning it would blank the record
# that uninstall uses to take them back out.
for p in added:
    if p not in man["permissions_added"]:
        man["permissions_added"].append(p)
perms["allow"] = allow
if added:
    note.append(f"added {len(added)} baseline permission(s)")

if not dry:
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2); f.write("\n")
    os.replace(tmp, path)
    with open(manifest_p, "w") as f:
        json.dump(man, f, indent=2); f.write("\n")

print("OK:" + "; ".join(note))
PY_MERGE_EOF

read -r -d '' PY_UNINSTALL <<'PY_UNINSTALL_EOF' || true
import json, os, sys

settings, manifest_p, root = os.environ["SETTINGS"], os.environ["MANIFEST"], os.environ["DIR"]
dry = os.environ["DRY"] == "1"
notes, wt = [], None

man = {}
if os.path.exists(manifest_p):
    try:
        with open(manifest_p) as f:
            man = json.load(f) or {}
        notes.append("read manifest")
    except Exception:
        notes.append("manifest unreadable — falling back to signature matching")
else:
    notes.append("no manifest — falling back to signature matching")

wt = man.get("worktree_dir")
added_perms = set(man.get("permissions_added") or [])
added_dirs  = set(man.get("additional_directories_added") or ([wt] if wt else []))
added_gi    = man.get("gitignore_added") or []

if os.path.exists(settings):
    try:
        with open(settings) as f:
            data = json.load(f) or {}
    except Exception as e:
        print(f"FATAL:{settings} is not valid JSON ({e}) — remove entries by hand")
        sys.exit(3)

    # Hook: always signature-matched. Only entries pointing at OUR guard go.
    hooks = data.get("hooks") or {}
    pre = hooks.get("PreToolUse")
    if isinstance(pre, list):
        kept = []
        removed = 0
        for e in pre:
            if isinstance(e, dict):
                inner = [h for h in (e.get("hooks") or [])
                         if not (isinstance(h, dict) and "git-guard.py" in str(h.get("command", "")))]
                if len(inner) != len(e.get("hooks") or []):
                    removed += 1
                    if inner:
                        e = dict(e, hooks=inner); kept.append(e)
                    continue
            kept.append(e)
        if removed:
            notes.append(f"removed {removed} git-guard hook entr" + ("y" if removed == 1 else "ies"))
        if kept:
            hooks["PreToolUse"] = kept
        else:
            hooks.pop("PreToolUse", None)
        if hooks:
            data["hooks"] = hooks
        else:
            data.pop("hooks", None)

    # disableAllHooks: we set it False. Touch it only if it is STILL exactly
    # False — if the user turned it back on since install, that is their call.
    # Restore whatever was there before install: absent -> remove the key,
    # true -> put the true back. The old code only ever removed the key, so a
    # user who had hooks disabled had that setting silently flipped for good.
    if data.get("disableAllHooks") is False:
        if "disable_all_hooks_was_present" in man:
            if man.get("disable_all_hooks_was_present"):
                prior = man.get("disable_all_hooks_prev")
                if prior is not False:
                    data["disableAllHooks"] = prior
                    notes.append("restored disableAllHooks = " + json.dumps(prior))
            else:
                data.pop("disableAllHooks", None)
                notes.append("removed disableAllHooks pin")
        elif man.get("set_disable_all_hooks"):  # manifest from an older install
            data.pop("disableAllHooks", None)
            notes.append("removed disableAllHooks pin")

    perms = data.get("permissions") or {}
    ad = perms.get("additionalDirectories")
    if isinstance(ad, list) and added_dirs:
        before = len(ad)
        ad = [d for d in ad if d not in added_dirs]
        if len(ad) != before:
            notes.append(f"removed {before - len(ad)} worktree grant(s)")
        if ad: perms["additionalDirectories"] = ad
        else:  perms.pop("additionalDirectories", None)

    allow = perms.get("allow")
    if isinstance(allow, list) and added_perms:
        before = len(allow)
        allow = [p for p in allow if p not in added_perms]
        if len(allow) != before:
            notes.append(f"removed {before - len(allow)} baseline permission(s)")
        if allow: perms["allow"] = allow
        else:     perms.pop("allow", None)

    if perms: data["permissions"] = perms
    else:     data.pop("permissions", None)

    if not dry:
        if data:
            tmp = settings + ".tmp"
            with open(tmp, "w") as f:
                json.dump(data, f, indent=2); f.write("\n")
            os.replace(tmp, settings)
        else:
            os.remove(settings)
            notes.append("settings.local.json was left empty — deleted")
else:
    notes.append("no settings.local.json found")

# .gitignore: remove only lines we added, and only if still present verbatim.
gi = os.path.join(root, ".gitignore")
if added_gi and os.path.exists(gi):
    with open(gi) as f:
        lines = f.read().splitlines()
    keep = []
    dropped = 0
    for ln in lines:
        if ln in added_gi and dropped < len(added_gi):
            dropped += 1
            continue
        keep.append(ln)
    if dropped and not dry:
        with open(gi, "w") as f:
            f.write("\n".join(keep).rstrip("\n") + ("\n" if keep else ""))
    if dropped:
        notes.append(f"removed {dropped} .gitignore line(s)")

if not dry and os.path.exists(manifest_p):
    os.remove(manifest_p)
    notes.append("removed manifest")

print("OK:" + (wt or "") + "|" + "; ".join(notes))
PY_UNINSTALL_EOF

# Renders a @@PLACEHOLDER@@ template from T_* environment variables. A
# placeholder with no matching variable is a LOUD failure, never a silently
# half-rendered prompt: an observer whose ledger says "@@BUILD_SID@@" would go
# looking for the build by mtime, which is the heuristic this feature exists to
# retire.
read -r -d '' PY_RENDER <<'PY_RENDER_EOF' || true
import os, re, sys

src, dst = os.environ["TPL"], os.environ["OUT_PATH"]
try:
    with open(src) as f:
        body = f.read()
except OSError as e:
    print(f"FATAL:cannot read template {src} ({e})")
    sys.exit(3)

missing = []

def rep(m):
    v = os.environ.get("T_" + m.group(1))
    if v is None:
        missing.append(m.group(1))
        return m.group(0)
    return v

body = re.sub(r"@@([A-Z0-9_]+)@@", rep, body)
if missing:
    print("FATAL:" + src + " has unset placeholder(s): " + ", ".join(sorted(set(missing))))
    sys.exit(3)

with open(dst, "w") as f:
    f.write(body)
print("OK:" + str(len(body)))
PY_RENDER_EOF

# Builds an observer session's permission profile. Every session claude-build
# starts is a `claude` process it shelled out to, so it is OUTSIDE the build's
# git-guard unless this script provisions it (references/run-permissions.md).
# The watchdog is resolved read-only-by-construction; the fixer is resolved by
# provisioning — it gets the same git-guard hook, plus a hard path deny on the
# build repo AND on the live skill, so its edits can only land in its own copy.
read -r -d '' PY_WATCH_SETTINGS <<'PY_WATCH_SETTINGS_EOF' || true
import json, os

role  = os.environ["ROLE"]           # watchdog | fixer
out   = os.environ["OUT_PATH"]
proj  = os.environ["DIR"]
wt    = os.environ["WT"]
obs   = os.environ["OBS"]
state = os.environ["STATE_DIR"]
tdir  = os.environ["PROJECTS_DIR"]
skill = os.environ["SKILL"]
guard = os.environ["GUARD"]
work  = os.environ.get("WORK_DIR", "")

def g(p):
    """A permission-rule glob covering everything under an absolute path."""
    return "//" + p.lstrip("/") + "/**"

# The write boundary. MEASURED, twice, against the profile as it actually ships:
#
#   * `Edit(<glob>)` is the ONLY path-rule spelling the permission layer matches
#     for files, and it covers every file-editing tool — Write creating a NEW
#     file, Write overwriting an existing one, Edit, and shell redirection
#     inside a Bash command. Claude Code rejects the alternatives at startup:
#     "Write(...) is not matched by file permission checks — only Edit(path)
#     rules are ... (Edit rules cover all file-editing tools)", and
#     "MultiEdit(...) matches no known tool". So one Edit rule per protected
#     path is the complete answer, and adding Write/MultiEdit/NotebookEdit
#     spellings would add startup warnings, not coverage. tests/test_harness.sh
#     pins this: every write-capable tool in the generated --tools list must be
#     one an Edit(path) rule covers.
#   * deny beats allow, always, and --restricted means user/project/local
#     settings files are not read at all, so nothing widens this from inside.
PROTECTED = [p for p in (proj, wt, tdir, skill) if p]
deny = ["Edit(" + g(p) + ")" for p in PROTECTED]

# Commands whose damage is not a file write the permission layer can see.
MUTATORS = [
    "git add", "git checkout", "git clean", "git commit", "git merge",
    "git push", "git rebase", "git reset", "git restore", "git rm",
    "git stash", "git switch", "git worktree add", "git worktree remove",
    "rm", "rmdir", "mv", "chmod", "chown", "kill", "pkill", "killall",
    "tmux kill-session", "tmux kill-server", "tmux send-keys", "tmux new-session",
    "curl", "wget", "ssh", "scp", "docker", "npm", "pnpm", "yarn", "pip", "pip3",
    "brew", "launchctl", "crontab", "defaults",
]
# Anything that can write a file WITHOUT a shell redirect is invisible to the
# permission layer — `python3 -c "open(p,'w')"` and `cp a b` both write with
# nothing for a path rule to match. Neither observer gets to run one.
INTERPRETERS = [
    "awk", "perl", "python", "python3", "node", "ruby", "sh", "bash", "zsh",
    "tee", "dd", "find", "sed -i", "cp", "ln", "truncate", "install", "xargs",
    "eval", "gzip", "tar", "zip", "unzip", "open", "osascript",
]
deny += ["Bash(" + c + ":*)" for c in MUTATORS]
# BOTH roles. The fixer has to execute the test suite, which is bash and
# python3 — but a bare `Bash(bash:*)` allow would also be a write path to any
# file on the machine, invisible to the permission layer, INCLUDING the live
# skill a build is running against right now. So it does not get the
# interpreters either: it gets one executable wrapper, run-tests.sh, which is
# the only way it can execute the suite.
deny += ["Bash(" + c + ":*)" for c in INTERPRETERS]

# A bare Bash allow, not an allow-list of read-only commands. Measured: with an
# allow-list, the FIRST thing the watchdog reached for was an unlisted compound
# command; under `acceptEdits` that prompts, and a prompt at an unattended pane
# is a watchdog that has silently stopped watching — the exact four-hour failure
# this feature exists to prevent. The boundary is therefore the deny list and
# the git-guard hook, not the allow list.
allow = ["Bash"]
allow += ["Read(" + g(p) + ")" for p in (proj, wt, obs, tdir, skill, state) if p]
allow += ["Edit(" + g(obs) + ")", "Edit(" + g(state) + ")"]

if role == "fixer":
    allow += ["Edit(" + g(work) + ")", "Read(" + g(work) + ")"]

cto = os.environ.get("CTO_DIR", "")
if role == "watchdog" and os.environ.get("CTO_ROLE") == "watchdog":
    # The CTO hat, under `all`. The store sits outside every directory the
    # BUILD session was granted, so the requester can ask but never grant and
    # never forge a grant. It is inside the watchdog's own state dir, so the
    # notebook grant already covers it; this is here to say so out loud.
    allow += ["Edit(" + g(cto) + ")"]
elif cto:
    # Nobody else writes approvals, including the fixer.
    deny += ["Edit(" + g(cto) + ")"]

if role == "watchdog":
    # Carve the fixer's two directories back out of the notebook grant above.
    # The watchdog's notebook IS the run directory, so it must be able to write
    # there — but the run directory also holds the fixer's working copy and the
    # pristine baseline it is diffed against, and the fixer's whole deliverable
    # is `diff -ruN skill-baseline skill`. An observer that can edit either side
    # of that diff can silently change what a human reviews, and the fixer has
    # no way to see it happen. Deny beats allow, so this narrows the grant
    # rather than revoking it. Derived from `state` and not WORK_DIR, because
    # the watchdog is generated with WORK_DIR="" — under plain `watch` neither
    # path exists and the denies are inert.
    #
    # Found by the watchdog, reading its own profile, on the first live
    # watch-fix run. Filed as W09030034-05.
    deny += ["Edit(" + g(state + "/" + d) + ")" for d in ("skill", "skill-baseline")]

data = {
    "disableAllHooks": False,
    "hooks": {"PreToolUse": [
        {"matcher": "Bash|Edit|Write|NotebookEdit|MultiEdit",
         "hooks": [{"type": "command", "command": 'python3 "' + guard + '"'}]}
    ]},
    "permissions": {"defaultMode": "acceptEdits",
                    "allow": sorted(set(allow)), "deny": sorted(set(deny))},
}

tmp = out + ".tmp"
with open(tmp, "w") as f:
    json.dump(data, f, indent=2); f.write("\n")
os.replace(tmp, out)
print("OK:%d allow / %d deny" % (len(data["permissions"]["allow"]),
                                 len(data["permissions"]["deny"])))
PY_WATCH_SETTINGS_EOF

# The run ledger. Every identity in the topology is written down BEFORE any
# session starts, so no agent in it ever has to correlate a pid to a transcript
# by timestamp. It is also the seam the authorization gate will read.
read -r -d '' PY_RUNJSON <<'PY_RUNJSON_EOF' || true
import json, os

KEYS = ["run_id", "run_tag", "topology", "authority", "shift", "project",
        "dir", "worktree_root", "skill", "state_dir", "obs_dir",
        "harness_doc", "build_doc", "build_launched",
        "cto_role", "cto_dir", "cto_log",
        "build_session_name", "build_session_id", "build_pid", "build_transcript",
        "watch_session_name", "watch_session_id",
        "fix_session_name", "fix_session_id", "work_dir", "created_at"]

data = {k: os.environ.get("R_" + k.upper(), "") for k in KEYS}
out = os.environ["OUT_PATH"]
tmp = out + ".tmp"
with open(tmp, "w") as f:
    json.dump(data, f, indent=2); f.write("\n")
os.replace(tmp, out)
print("OK:" + out)
PY_RUNJSON_EOF

# Dropped into the run's state directory as runinfo.py and wrapped by three
# one-line shell scripts, so the observers' permission profiles can allow those
# three exact commands and nothing else. Read-only: it stats and reads, never
# writes, never signals, never touches a peer.
read -r -d '' RUNINFO_PY <<'RUNINFO_PY_EOF' || true
#!/usr/bin/env python3
"""Read-only helpers for the watcher sessions of one claude-build run.

Everything here answers from the authoritative session registry at
~/.claude/sessions/<pid>.json — the file that appears ~5-8s after a session
launches and is removed within ~6s of it dying. Nothing here mutates anything,
and nothing here interrupts a peer.

  peers          one line per session in this run, straight from the registry
  wait-build     block until the build session next goes idle / dies / times out
  wait-harness   block until the harness observation document changes
"""
import json
import os
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
REG = os.path.join(os.path.expanduser("~"), ".claude", "sessions")

with open(os.path.join(HERE, "run.json")) as _f:
    RUN = json.load(_f)


def records():
    out = []
    try:
        names = sorted(os.listdir(REG))
    except OSError:
        return out
    for fn in names:
        if not fn.endswith(".json"):
            continue
        try:
            with open(os.path.join(REG, fn)) as f:
                out.append(json.load(f))
        except Exception:
            continue          # a record being rewritten is not an error
    return out


def find(session_id):
    if not session_id:
        return None
    for r in records():
        if r.get("sessionId") == session_id:
            return r
    return None


def cmd_peers(_argv):
    rows = [("build", RUN.get("build_session_id"), RUN.get("build_session_name")),
            ("watchdog", RUN.get("watch_session_id"), RUN.get("watch_session_name")),
            ("fixer", RUN.get("fix_session_id"), RUN.get("fix_session_name"))]
    for role, sid, name in rows:
        if not sid or not name or name.startswith("("):
            continue
        r = find(sid)
        if r is None:
            print("%-9s %-40s NOT-REGISTERED (not started yet, or already gone)"
                  % (role, name))
        else:
            print("%-9s %-40s pid=%-7s status=%-5s tmux=%s"
                  % (role, name, r.get("pid"), r.get("status", "?"),
                     r.get("tmux", "-")))
    return 0


def cmd_wait_build(argv):
    """Blocks. Prints exactly one verdict word, so a caller cannot mistake
    'still running' for 'finished'."""
    sid = RUN.get("build_session_id")
    limit = float(argv[0]) if argv else 1800.0
    deadline = time.time() + limit
    seen = False
    while time.time() < deadline:
        r = find(sid)
        if r is None:
            if seen:
                print("BUILD-GONE")
                return 0
        else:
            seen = True
            if r.get("status") == "idle":
                print("BUILD-IDLE")
                return 0
        time.sleep(10)
    print("BUILD-WAIT-TIMEOUT" if seen else "BUILD-NOT-STARTED")
    return 0


def cmd_wait_harness(argv):
    path = RUN.get("harness_doc")
    limit = float(argv[0]) if argv else 1800.0
    deadline = time.time() + limit

    def stamp():
        try:
            st = os.stat(path)
        except OSError:
            return None
        return (st.st_mtime, st.st_size)

    base = stamp()
    if base is None:
        print("HARNESS-GONE")
        return 0
    while time.time() < deadline:
        time.sleep(5)
        cur = stamp()
        if cur is None:
            print("HARNESS-GONE")
            return 0
        if cur != base:
            print("HARNESS-CHANGED")
            return 0
    print("HARNESS-WAIT-TIMEOUT")
    return 0


CMDS = {"peers": cmd_peers,
        "wait-build": cmd_wait_build,
        "wait-harness": cmd_wait_harness}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in CMDS:
        print("usage: runinfo.py {%s} [seconds]" % "|".join(sorted(CMDS)),
              file=sys.stderr)
        sys.exit(2)
    sys.exit(CMDS[sys.argv[1]](sys.argv[2:]))
RUNINFO_PY_EOF

usage() {
  cat <<'HELP_TEXT'
claude-build — open a Claude Code session preconfigured for a swarm-loop run.

USAGE
  claude-build [DIR] [options]
  claude-build [DIR] watch|watch-fix|full-auto|all [options]
  claude-build [DIR] --uninstall
  claude-build --uninstall-self
  claude-build --sessions

ARGUMENTS
  DIR                  Project directory. Default: current directory.
                       Created, and git-initialized, if it does not exist.

SESSION TOPOLOGY (modifiers — bare word or --flag, both accepted)
  watch                Also start a WATCHDOG in a second terminal session. It
                       watches the build and the harness and writes what it
                       finds to two global observation documents under
                       ~/claude-build/observations/ — one for the harness, one
                       for the build. It is read-only with respect to the build repo
                       and the skill, enforced by its permission profile, and
                       can message the other sessions.
  watch-fix            Everything `watch` does, plus a third session: a FIXER
                       that watches the harness document and fixes what is
                       obviously fixable — in a COPY of the skill, never in the
                       live one, and never as a commit.
  full-auto            `watch`'s TWO sessions, with the watcher also wearing
                       a CTO hat: it may authorize non-destructive operations
                       the guard blocked pending review.
  all                  `watch-fix`'s THREE sessions, with the same CTO hat on
                       the watcher. full-auto and all differ ONLY by the fixer.

                       In both, the build still asks and someone else still
                       grants, so the requester cannot approve itself, and
                       every approval is appended to a log that sits outside
                       every directory the build can reach.

                       full-auto and all BOTH REFUSE TO LAUNCH TODAY. The
                       gate they contain lives in hooks/git-guard.py and does
                       not exist yet, and a watcher holding an authority it
                       does not have is a review step you would believe was
                       happening. They exit 3 naming what is missing.
                       See references/watch-sessions.md.

  NOTE  A modifier is a bare word, so a project directory literally named
        `watch`, `watch-fix`, `full-auto` or `all` must be written `./watch`.

  NOTE  `watch-fix` and `--audit-loops N` are different mechanisms that happen
        to share a word. `--audit-loops` is the skill's ACT TWO: whole-codebase
        audit -> ticket -> fix loops running INSIDE the one build session.
        `watch-fix` starts additional SESSIONS beside it. They compose.

OPTIONS
  --spec FILE          Spec / PRD / build-doc to hand the skill on open.
  --audit-loops N      Act-two audit-fix loops INSIDE the build session, after
                       it converges (default: ask). Not a session count.
  --max-cycles N       Runaway safety ceiling (default: ask).
  --in-tree            Force worktrees to .swarm-loop/worktrees/ instead of a
                       sibling directory. Costs you the metric-contamination
                       protection; see references/run-permissions.md.
  --no-launch          Configure and probe, but do not start the BUILD session.
                       With a modifier the watchers still start — they are what
                       you asked for — and the printed build command carries the
                       session name and id they were bound to.
  --dry-run            Show what would change. Writes nothing, starts nothing.
  -q, --quiet          Only warnings and errors.
  -h, --help           This text.

UNINSTALL
  --uninstall          Remove from DIR exactly what claude-build added: the
                       git-guard hook, the worktree grant, the baseline
                       permissions, and its .gitignore lines. Anything you
                       added yourself is left alone. Reads the manifest at
                       .claude/.claude-build.json; falls back to signature
                       matching if that file is gone.
  --purge              With --uninstall only: also delete the worktree
                       directory and prune stale worktree registrations. Takes
                       the directory from the manifest and refuses to guess if
                       the manifest is gone. Refuses if any worktree still holds
                       uncommitted work, or if git cannot say whether it does.
  --uninstall-self     Delete the claude-build script itself. Does not touch
                       any project; run --uninstall in each project first.
  --sessions           List every recorded run and the tmux attach command for
        (--status)     each watcher it started, marking each LIVE or gone.
                       Takes no DIR and starts nothing.
                       READ THIS IF YOU THINK ONLY ONE SESSION OPENED. In every
                       watcher topology exactly one window appears: the BUILD is
                       exec'd into the terminal you launched from, while the
                       watchers are DETACHED tmux sessions. claude-build prints
                       their attach commands immediately before that exec — and
                       Claude Code clears the screen as it starts, so those lines
                       are gone before they can be read. This is how you get them
                       back.

WHAT INSTALL DOES
  1. Creates / git-initializes the project directory.
  2. Picks a worktree location outside the repo (so root-walking metric
     commands cannot count in-flight workers' checkouts).
  3. Merges the git-guard hook + permission grants into
     .claude/settings.local.json, non-destructively and idempotently.
  4. PROBES the guard and the worktree grant, and refuses to launch if either
     fails. A guard you did not prove is a guard you do not have.
  5. With a modifier: mints every session's name and id UP FRONT, starts the
     watchers in detached tmux sessions, and refuses to launch the build if a
     watcher did not register in ~/.claude/sessions/. A watcher you did not
     see register is a watcher you do not have.
  6. Launches Claude Code with the worktree directory already granted.

WATCHERS
  Each watcher runs in its own detached tmux session; `tmux attach -t <name>`
  drops you into it and `tmux kill-session -t <name>` ends it. Both names, and
  a teardown script, are printed at launch and written to the run's state
  directory under ~/claude-build/runs/<run-id>/. Nothing a watcher writes ever
  lands inside the project repository.

  A watcher is read-only with respect to the build repo, its worktrees, the
  transcript directory and the live skill — enforced by its permission profile,
  measured by attacking it. See references/watch-sessions.md.
HELP_TEXT
  exit 0
}

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)        usage ;;
    --spec)           need_val "$1" "$#" "${2:-}"; SPEC="$2"; shift 2 ;;
    --audit-loops)    need_val "$1" "$#" "${2:-}"; num_val "$1" "$2"
                      AUDIT_LOOPS="$2"; shift 2 ;;
    --max-cycles)     need_val "$1" "$#" "${2:-}"; num_val "$1" "$2"
                      MAX_CYCLES="$2"; shift 2 ;;
    --in-tree)        IN_TREE=1; shift ;;
    --no-launch)      LAUNCH=0; shift ;;
    --dry-run)        DRY=1; LAUNCH=0; shift ;;
    --uninstall)      MODE=uninstall; LAUNCH=0; shift ;;
    --purge)          PURGE=1; shift ;;
    --uninstall-self) MODE=uninstall-self; LAUNCH=0; shift ;;
    --sessions|--status)
                      MODE=sessions; LAUNCH=0; shift ;;
    -q|--quiet)       QUIET=1; shift ;;
    # Session-topology modifiers. These MUST sit above the `-*)` arm (so the
    # --flag spellings are not swallowed as unknown options) and above the `*)`
    # arm (so the bare words are not swallowed as the project directory — a
    # bare word there is how `claude-build watch` would otherwise silently
    # create a directory called "watch"). Both spellings are accepted so that a
    # typo like `--wtch` still lands on the unknown-option error.
    watch|--watch)          [ -n "$WATCH" ] && [ "$WATCH" != watch ] \
                              && die "two topology modifiers given: $WATCH and $1"
                            WATCH=watch; shift ;;
    watch-fix|--watch-fix)  [ -n "$WATCH" ] && [ "$WATCH" != watch-fix ] \
                              && die "two topology modifiers given: $WATCH and $1"
                            WATCH=watch-fix; shift ;;
    full-auto|--full-auto)  [ -n "$WATCH" ] && [ "$WATCH" != full-auto ] \
                              && die "two topology modifiers given: $WATCH and $1"
                            WATCH=full-auto; shift ;;
    all|--all)              [ -n "$WATCH" ] && [ "$WATCH" != all ] \
                              && die "two topology modifiers given: $WATCH and $1"
                            WATCH=all; shift ;;
    -*)               die "unknown option: $1  (claude-build --help)" ;;
    *)                [ -n "$DIR" ] && die "more than one directory given: $DIR and $1"
                      DIR="$1"; shift ;;
  esac
done

# ------------------------------------------------ cross-flag validation
# A modifier is orthogonal to MODE, so it needs its own check — same shape as
# the --purge one below it: name the flag, name what it needs, and name what you
# actually asked for, rather than quietly doing nothing.
if [ -n "$WATCH" ] && [ "$MODE" != install ]; then
  die "$WATCH only means anything on a build run (you asked for: $MODE)"
fi
# --purge is only ever READ under --uninstall. Accepting it silently anywhere
# else means `claude-build ~/proj --purge` reads as "remove the worktrees" and
# does the opposite — a full INSTALL — with no hint that the flag did nothing.
if [ "$PURGE" = 1 ] && [ "$MODE" != uninstall ]; then
  die "--purge only means anything with --uninstall (you asked for: $MODE)"
fi

# ------------------------------------------------------ the full-auto gate
# full-auto's entire content is an authorization gate that lives in
# hooks/git-guard.py. Until that gate exists there is nothing to authorize with,
# and a full-auto that started a CTO session anyway would be a review step the
# operator BELIEVES is happening and which is not — strictly worse than the
# feature not existing. So it refuses, loudly, and names the missing piece.
#
# The seam is one grep. When the guard grows the gate it declares the sentinel
# below, and this refusal becomes a launch. See references/watch-sessions.md.
if [ "$WATCH" = full-auto ] || [ "$WATCH" = all ]; then
  if grep -q "$GATE_SENTINEL" "$GUARD" 2>/dev/null; then
    AUTHORITY=1
    # Both put the CTO hat on the WATCHER rather than adding another session:
    # the requester is still the build and the grantor is still someone else,
    # so the separation that matters survives without a fourth agent. The ONLY
    # difference between the two modifiers is the fixer —
    #
    #   full-auto = the `watch` topology     (build + watcher) + authority
    #   all       = the `watch-fix` topology (build + watcher + fixer) + authority
    #
    # so each collapses to the topology it is built on, and CTO_ROLE says who
    # wears the hat in both.
    CTO_ROLE=watchdog
    [ "$WATCH" = full-auto ] && WATCH=watch
    [ "$WATCH" = all ]       && WATCH=watch-fix
    # Fail closed on the collapse itself. Everything downstream branches on
    # WATCH being one of the two launchable topologies, and a value that got
    # here uncollapsed would quietly behave like `watch` — which is right for
    # full-auto by accident and wrong for anything else. An internal state
    # nobody checked is the silent-verdict failure this script exists to avoid.
    case "$WATCH" in
      watch|watch-fix) ;;
      *) die "internal: topology '$WATCH' did not collapse to watch or watch-fix" ;;
    esac
  else
    GATE_FALLBACK=watch
    [ "$WATCH" = all ] && GATE_FALLBACK=watch-fix
    printf '\033[31merror:\033[0m %s is not available — its authorization gate is not installed.\n' "$WATCH" >&2
    cat >&2 <<GATE_EOF

  What is missing
    $GUARD does not declare $GATE_SENTINEL.
    Without it no session can grant anything, so a CTO would be a review
    step you believe is happening and which is not. Both full-auto and all
    contain that gate, so both refuse until it exists — rather than
    starting the watchers and quietly skipping the half you asked for.

  What a CTO will and will not be able to do, once the gate lands
    MAY authorize   a NON-DESTRUCTIVE operation the guard blocked pending
                    review — creating a new remote directory, say. Bounded by
                    reversibility, not by how good the reasoning is.
    NEVER authorizes a DESTRUCTIVE operation. Deleting that same directory has
                    no "ask the CTO" path at all; it goes straight to you.
    NEVER overrides a denial in your own settings. A user-level deny is
                    absolute and no agent grants past it.

  What to do now
    Use  claude-build ${DIR:-.} $GATE_FALLBACK  for the same sessions without
    the authorization gate, and rerun with $WATCH once the guard declares the
    sentinel. The sessions are identical either way; what is missing is only
    the authority the watcher would have held.

GATE_EOF
    exit 3
  fi
fi

# ---------------------------------------------------------------- sessions
# Why this exists. In every watcher topology the build is exec'd into THIS
# terminal while the watchers go to DETACHED tmux sessions, so a correct run
# shows the operator exactly one window. The attach commands are printed just
# before the exec — and Claude Code clears the screen on startup, so they are
# gone before they can be read. Measured: a watch-fix run started all three
# sessions correctly and was reported as "it only opened one", because after
# the exec nothing on the machine will tell you the other two names again.
# A launcher whose only record of what it started is destroyed by its own last
# instruction has not told you anything.
if [ "$MODE" = sessions ]; then
  step "claude-build — sessions"
  command -v tmux >/dev/null || warn "tmux is not on PATH; liveness cannot be checked"
  FOUND=0
  for J in "$RUNS"/*/run.json; do
    [ -f "$J" ] || continue
    FOUND=1
    RID=$(basename "$(dirname "$J")")
    py() { python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get(sys.argv[2],"") or "")' "$J" "$1"; }
    TOPO=$(py topology); PROJ=$(py project); SDIR=$(py state_dir)
    WN=$(py watch_session_name); FN=$(py fix_session_name); BN=$(py build_session_name)
    echo
    echo "  $RID   project=$PROJ  topology=${TOPO:-?}"
    for pair in "watchdog:$WN" "fixer:$FN"; do
      ROLE=${pair%%:*}; NAME=${pair#*:}
      [ -n "$NAME" ] || continue
      if tmux has-session -t "$NAME" 2>/dev/null; then
        printf '    %-9s LIVE   tmux attach -t %s\n' "$ROLE" "$NAME"
      else
        printf '    %-9s gone   %s\n' "$ROLE" "$NAME"
      fi
    done
    [ -n "$BN" ] && printf '    %-9s %s   (exec\x27d into the terminal you launched from, never tmux)\n' "build" "$BN"
    [ -f "$SDIR/teardown.sh" ] && printf '    %-9s bash %s\n' "teardown" "$SDIR/teardown.sh"
  done
  [ "$FOUND" = 0 ] && warn "no runs recorded under $RUNS"
  echo
  echo "  Detach from an attached session with: ctrl-b d"
  exit 0
fi

# ------------------------------------------------------------ uninstall-self
if [ "$MODE" = uninstall-self ]; then
  TARGET="$(cd "$(dirname "$SELF")" && pwd -P)/$(basename "$SELF")"
  step "claude-build — uninstall self"
  warn "this removes the launcher only; per-project config stays until you run"
  warn "  claude-build <dir> --uninstall   in each project you configured"
  if [ "$DRY" = 1 ]; then echo "  would delete: $TARGET"; exit 0; fi
  rm -f "$TARGET" && ok "deleted $TARGET"
  echo
  echo "The swarm-loop skill itself is untouched at $SKILL."
  exit 0
fi

# ---------------------------------------------------------------- preflight
[ -f "$GUARD" ]   || die "git-guard not found at $GUARD — is the swarm-loop skill installed?"
[ -f "$HARNESS" ] || die "swarmloop.py not found at $HARNESS — is the swarm-loop skill installed?"
command -v python3 >/dev/null || die "python3 not on PATH (the guard and harness need it)"
command -v git     >/dev/null || die "git not on PATH"
[ "$MODE" = install ] && { command -v claude >/dev/null || die "claude not on PATH"; }

# Watcher preflight. tmux is the launch primitive: a detached session survives
# this script exec'ing away, takes scripted input, can be read back with
# capture-pane, and the human can `tmux attach` to watch or type. Nothing else
# available here does all four.
TPL_DIR="$SKILL/templates"
if [ -n "$WATCH" ]; then
  command -v tmux >/dev/null || die "tmux not on PATH — $WATCH needs it to hold the watcher sessions (brew install tmux)"
  for t in watchdog-prompt.md obs-harness.md obs-build.md; do
    [ -f "$TPL_DIR/$t" ] || die "missing template $TPL_DIR/$t — is the swarm-loop skill complete?"
  done
  [ "$WATCH" = watch ] || [ -f "$TPL_DIR/fixer-prompt.md" ] \
    || die "missing template $TPL_DIR/fixer-prompt.md — is the swarm-loop skill complete?"
fi

DIR="${DIR:-$PWD}"
if [ ! -d "$DIR" ]; then
  # Only install mode creates the directory. A missing DIR used to silently
  # fall back to $PWD, so one typo in `claude-build ~/prject --uninstall --purge`
  # pointed the rm -rf and the settings surgery at whatever repo you happened to
  # be standing in. Outside install mode a path that does not exist is an ABORT.
  if [ "$MODE" != install ]; then
    die "no such directory: $DIR  (refusing to fall back to $PWD in $MODE mode)"
  fi
  # if/else, not `A && B || C`: with the && form a failed echo (closed stdout)
  # falls through and creates the directory during a --dry-run.
  if [ "$DRY" = 1 ]; then echo "would create directory: $DIR"; else mkdir -p "$DIR"; fi
fi
if [ -d "$DIR" ]; then
  DIR="$(cd "$DIR" && pwd -P)"
else
  # --dry-run install of a directory that does not exist yet: nothing was
  # created, so make the path absolute without cd-ing into it.
  case "$DIR" in /*) ;; *) DIR="$PWD/${DIR#./}" ;; esac
fi
if git -C "$DIR" rev-parse --show-toplevel >/dev/null 2>&1; then
  ROOT="$(git -C "$DIR" rev-parse --show-toplevel)"
  [ "$ROOT" != "$DIR" ] && { warn "$DIR is inside the repo at $ROOT — using the repo root"; DIR="$ROOT"; }
fi
NAME="$(basename "$DIR")"
SETTINGS="$DIR/.claude/settings.local.json"
MANIFEST="$DIR/.claude/.claude-build.json"

# Is every registered worktree at or under $1 clean enough to delete? Returns 0
# only when the answer is a proven yes.
#
# The old one-liner was
#   git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}' | grep -F "$BASE"
# which is wrong three ways, each of which ends in rm -rf'ing live work:
#   * awk '{print $2}' truncates a worktree path at its first space, so a
#     checkout under "/Users/me/My Proj-worktrees/t1" was never status-checked;
#   * grep -F substring-matches, so "…-worktrees.bak/t1" counted as ours while
#     the truncated paths above matched nothing at all;
#   * 2>/dev/null on both git calls made the check fail OPEN — a git that could
#     not answer read as "all clean, go ahead".
# So: split on the `worktree ` sentinel (paths keep their spaces), match the base
# exactly, and fail CLOSED when git cannot answer.
wt_clean() {
  local base="$1" listing line w st rc=0
  if ! listing="$(git -C "$DIR" worktree list --porcelain 2>&1)"; then
    warn "cannot list worktrees in $DIR — git said: ${listing%%$'\n'*}"
    return 1
  fi
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) w="${line#worktree }" ;;
      *)            continue ;;
    esac
    case "$w" in
      "$base"|"$base"/*) ;;
      *)                 continue ;;
    esac
    # A registration whose directory is already gone holds no work to lose —
    # that is precisely what `git worktree prune` below cleans up.
    [ -d "$w" ] || continue
    if ! st="$(git -C "$w" status --porcelain 2>&1)"; then
      warn "cannot read git status in $w — git said: ${st%%$'\n'*}"
      rc=1; continue
    fi
    if [ -n "$st" ]; then
      warn "uncommitted work in $w"; rc=1
    fi
  done <<< "$listing"
  return "$rc"
}
# --spec is resolved and CHECKED here rather than pasted into the prompt
# unexamined. A mistyped path used to reach the build as a confident sentence
# ("The spec is at: docs/SEPC.md"), and a build that cannot find its spec
# invents one.
if [ -n "$SPEC" ]; then
  if   [ -f "$SPEC" ];        then SPEC="$(cd "$(dirname "$SPEC")" && pwd -P)/$(basename "$SPEC")"
  elif [ -f "$DIR/$SPEC" ];   then SPEC="$DIR/$SPEC"
  else die "--spec: no such file — tried '$SPEC' and '$DIR/$SPEC'"
  fi
fi

# ================================================================ UNINSTALL
if [ "$MODE" = uninstall ]; then
  step "claude-build — uninstall from $NAME"
  [ "$DRY" = 1 ] && warn "DRY RUN — nothing will be removed"

  # The manifest is the ONLY thing allowed to name a directory we rm -rf. The old
  # code invented "$(dirname "$DIR")/$NAME-worktrees" whenever the manifest was
  # missing or unreadable and then deleted that guess — a directory claude-build
  # may never have created, and may well be someone else's work. Read it here,
  # before the uninstall step deletes the manifest.
  WT_REC="$(MANIFEST="$MANIFEST" python3 -c 'import json,os;p=os.environ["MANIFEST"];print((json.load(open(p)).get("worktree_dir") or "") if os.path.exists(p) else "")' 2>/dev/null || true)"

  # Safety first: if --purge could refuse, it must refuse BEFORE anything is
  # removed. Otherwise a refusal leaves the project half-uninstalled.
  if [ "$PURGE" = 1 ]; then
    [ -n "$WT_REC" ] || die "--purge needs the install manifest at $MANIFEST to know which directory to delete, and it is missing or unreadable. Refusing to guess — rerun without --purge and remove the worktree directory by hand."
    case "$WT_REC" in
      /*) ;;
      *)  die "manifest worktree_dir is not an absolute path ($WT_REC) — refusing to purge" ;;
    esac
    [ "$WT_REC" = "/" ] && die "manifest worktree_dir is / — refusing to purge"
    case "$DIR/" in
      "$WT_REC"/*) die "manifest worktree_dir $WT_REC contains the project $DIR — refusing to purge" ;;
    esac
    wt_clean "$WT_REC" || die "refusing to purge — worktrees under $WT_REC are not all clean, or git could not say. Nothing was removed; commit or discard, then rerun."
  fi

  OUT="$(SETTINGS="$SETTINGS" MANIFEST="$MANIFEST" DIR="$DIR" DRY="$DRY" python3 -c "$PY_UNINSTALL")" || true

  case "$OUT" in
    FATAL:*) die "${OUT#FATAL:}" ;;
    # The wt field before the "|" is the same manifest value already read into
    # WT_REC above; only the notes are consumed here. `for n in "${N[@]}"` is an
    # unbound-variable error on bash 3.2 when NOTES is empty, so guard it.
    OK:*)    BODY="${OUT#OK:}"; NOTES="${BODY#*|}"
             IFS=';' read -ra N <<< "$NOTES"
             for n in ${N[@]+"${N[@]}"}; do ok "${n# }"; done ;;
    *)       die "uninstall failed: ${OUT:-no output}" ;;
  esac

  if [ "$PURGE" = 1 ]; then
    step "Purge — worktrees"
    # Re-checked immediately before the delete: this is the check that actually
    # guards the rm -rf, and the settings surgery above took real time.
    wt_clean "$WT_REC" || die "refusing to purge — worktrees under $WT_REC are not all clean, or git could not say (commit or discard, then rerun)"
    if [ "$DRY" = 1 ]; then echo "  would delete $WT_REC and run git worktree prune"
    else
      rm -rf -- "$WT_REC"
      git -C "$DIR" worktree prune || warn "git worktree prune failed — run it by hand in $DIR"
      ok "deleted $WT_REC and pruned"
    fi
  elif [ -n "$WT_REC" ] && [ -d "$WT_REC" ]; then
    warn "worktree dir left in place: $WT_REC  (--purge removes it)"
  fi

  step "Done"
  echo "  The swarm-loop skill and any .swarm-loop/ run state are untouched."
  echo "  Restart Claude Code for the hook removal to take effect."
  exit 0
fi

# ================================================================== INSTALL
step "claude-build — $NAME"
[ "$DRY" = 1 ] && warn "DRY RUN — nothing will be written"

step "1. Repository"
GIT_ID=(-c "user.email=$(git config user.email 2>/dev/null || echo build@local)"
        -c "user.name=$(git config user.name 2>/dev/null || echo claude-build)")
if git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1; then
  ok "git repo at $DIR"
  if ! git -C "$DIR" rev-parse HEAD >/dev/null 2>&1; then
    if [ "$DRY" = 1 ]; then echo "  would create an initial commit (repo has no HEAD)"
    else git -C "$DIR" "${GIT_ID[@]}" commit -q --allow-empty -m "initial commit"; ok "created initial commit"; fi
  fi
else
  if [ "$DRY" = 1 ]; then echo "  would run: git init -b main; initial commit"
  else
    git -C "$DIR" init -q -b main
    git -C "$DIR" "${GIT_ID[@]}" commit -q --allow-empty -m "initial commit"
    ok "git init -b main + initial commit (greenfield)"
  fi
fi

step "2. Worktree location"
PARENT="$(dirname "$DIR")"
WT="$PARENT/${NAME}-worktrees"; WT_MODE="sibling"
if [ "$IN_TREE" = 1 ]; then
  WT="$DIR/.swarm-loop/worktrees"; WT_MODE="in-tree (forced)"
# The `mkdir -p` below is how this probe learns the parent is really writable,
# but it also CREATES the directory — under --dry-run, which advertises "Writes
# nothing", that left a <name>-worktrees/ behind in the user's parent directory.
# In dry-run mode settle for what can be learned without writing.
elif ! ( [ -w "$PARENT" ] && ( [ -d "$WT" ] || [ "$DRY" = 1 ] || mkdir -p "$WT" 2>/dev/null ) ); then
  WT="$DIR/.swarm-loop/worktrees"; WT_MODE="in-tree (parent not writable)"
  warn "cannot write to $PARENT — falling back in-tree"
  warn "metric commands MUST then exclude .swarm-loop/ (see goal-setting.md)"
fi
[ "$DRY" = 1 ] || mkdir -p "$WT"
ok "$WT_MODE → $WT"

step "3. Settings (.claude/settings.local.json)"
[ "$DRY" = 1 ] || mkdir -p "$DIR/.claude"
MERGE_OUT="$(WT="$WT" SETTINGS="$SETTINGS" MANIFEST="$MANIFEST" DRY="$DRY" python3 -c "$PY_MERGE")" || true
case "$MERGE_OUT" in
  FATAL:*) die "${MERGE_OUT#FATAL:}" ;;
  OK:*)    ok "${MERGE_OUT#OK:}" ;;
  *)       die "settings merge failed: ${MERGE_OUT:-no output}" ;;
esac

# settings.local.json is not the only file that can turn the guard off, and it
# was the only one this script ever looked at. A project .claude/settings.json —
# or the user-level ~/.claude/settings.json — carrying "disableAllHooks": true
# leaves the session with NO hooks at all, and every probe in step 5 still comes
# back green, because those probes pipe JSON straight into git-guard.py and never
# go through the settings harness that reads these files. Four green checks over
# a dead guard is the worst failure this script can produce, so look, say so
# loudly, and let step 5 refuse the launch.
HOOKS_OFF_AT=""
for OTHER in "$DIR/.claude/settings.json" "$HOME/.claude/settings.json"; do
  [ -f "$OTHER" ] || continue
  OTHER_STATE="$(OTHER="$OTHER" python3 -c '
import json, os
try:
    d = json.load(open(os.environ["OTHER"])) or {}
except Exception:
    print("unreadable"); raise SystemExit
print("off" if d.get("disableAllHooks") is True else "ok")' 2>/dev/null || echo unreadable)"
  case "$OTHER_STATE" in
    off) HOOKS_OFF_AT="$OTHER"
         warn "$OTHER sets \"disableAllHooks\": true"
         warn "  that switch kills EVERY hook for the session — including the git-guard"
         warn "  just written to settings.local.json — and it outlives this script."
         warn "  Remove that key from $OTHER, then rerun." ;;
    unreadable) warn "could not parse $OTHER — check it by hand for disableAllHooks" ;;
  esac
done

step "4. .gitignore"
GI="$DIR/.gitignore"
NEEDED='.claude/settings.local.json
.claude/.claude-build.json
.swarm-loop/worktrees/
.swarm-loop/archive/
__pycache__/
*.py[co]
.pytest_cache/
.mypy_cache/'
if [ "$DRY" = 1 ]; then
  echo "  would ensure $(printf '%s\n' "$NEEDED" | wc -l | tr -d ' ') entries in .gitignore"
else
  ADDED_LINES=()
  touch "$GI"
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    grep -qxF "$line" "$GI" 2>/dev/null || { printf '%s\n' "$line" >> "$GI"; ADDED_LINES+=("$line"); }
  done <<< "$NEEDED"
  if [ ${#ADDED_LINES[@]} -gt 0 ]; then
    # Append to the recorded list, do not replace it: a later install that adds
    # one new line used to wipe the first install's record, stranding the rest of
    # the .gitignore entries in the project forever.
    printf '%s\n' "${ADDED_LINES[@]}" | MANIFEST="$MANIFEST" python3 -c '
import json,os,sys
p=os.environ["MANIFEST"]
try:
    m=json.load(open(p)) if os.path.exists(p) else {}
except Exception:
    m={}
seen=m.get("gitignore_added") or []
for l in (x.rstrip("\n") for x in sys.stdin):
    if l.strip() and l not in seen:
        seen.append(l)
m["gitignore_added"]=seen
json.dump(m,open(p,"w"),indent=2)'
  fi
  ok "${#ADDED_LINES[@]} entr$([ ${#ADDED_LINES[@]} = 1 ] && echo y || echo ies) added"
fi

step "5. Probes — proving the configuration, not assuming it"
if [ "$DRY" = 1 ]; then
  echo "  would probe: guard blocks 'git stash' / allows 'git status' / blocks the"
  echo "               multi-line form; worktree add+write+read+teardown at $WT"
else
  probe_guard() {
    printf '%s' "$1" \
      | python3 -c 'import json,sys;print(json.dumps({"tool_name":"Bash","tool_input":{"command":sys.stdin.read()}}))' \
      | python3 "$GUARD" >/dev/null 2>&1
    echo $?
  }
  FAIL=0
  R="$(cd "$DIR" && probe_guard 'git stash')"
  [ "$R" = 2 ] && ok "guard BLOCKS 'git stash' (exit 2)" || { warn "guard did NOT block 'git stash' (exit $R)"; FAIL=1; }
  R="$(cd "$DIR" && probe_guard 'git status --porcelain')"
  [ "$R" = 0 ] && ok "guard ALLOWS 'git status' (exit 0)" || { warn "guard blocked a read-only command (exit $R)"; FAIL=1; }
  R="$(cd "$DIR" && probe_guard $'git status\ngit stash')"
  [ "$R" = 2 ] && ok "guard blocks the multi-line form (exit 2)" || { warn "multi-line bypass is open (exit $R)"; FAIL=1; }

  # A grant covering reads but not writes passes the first half of this and
  # hangs the wave on the second, so probe all four operations.
  #
  # The name is per-process: a fixed "_cb_probe" collides with a second
  # claude-build running against the same repo, and with the leftover branch of
  # any earlier run whose cleanup did not complete — which showed up as a
  # worktree probe FAILURE on a perfectly good repo.
  PROBE_ID="_cb_probe_$$_${RANDOM}"
  PROBE_WT="$WT/$PROBE_ID"
  if ( cd "$DIR" \
       && git worktree add -q "$PROBE_WT" -b "$PROBE_ID" >/dev/null 2>&1 \
       && echo probe > "$PROBE_WT/probe.txt" \
       && [ "$(cat "$PROBE_WT/probe.txt")" = probe ] ); then
    ok "worktree add + write + read at $WT"
  else
    warn "worktree probe FAILED at $WT"; FAIL=1
  fi

  # Teardown used to end in `|| true`, so a probe worktree left registered in the
  # repo — which pollutes every later `git worktree list` and any root-walking
  # metric command — was completely silent. Say what is left behind.
  CLEAN=0
  [ -e "$PROBE_WT" ] && { rm -rf -- "$PROBE_WT" || CLEAN=1; }
  git -C "$DIR" worktree prune >/dev/null 2>&1 || CLEAN=1
  if git -C "$DIR" rev-parse --verify -q "refs/heads/$PROBE_ID" >/dev/null 2>&1; then
    git -C "$DIR" branch -qD "$PROBE_ID" >/dev/null 2>&1 || CLEAN=1
  fi
  if [ "$CLEAN" = 1 ] || [ -e "$PROBE_WT" ]; then
    warn "probe cleanup incomplete — remove $PROBE_WT and branch $PROBE_ID by hand"
  else
    ok "probe worktree + branch torn down"
  fi

  # Green probes prove git-guard.py works; they cannot prove the session will
  # ever call it. See the disableAllHooks scan in step 3.
  if [ -n "$HOOKS_OFF_AT" ]; then
    warn "disableAllHooks: true in $HOOKS_OFF_AT — the probes above cannot see this, and the guard will not run"
    FAIL=1
  fi

  [ "$FAIL" = 1 ] && die "probes failed — refusing to launch. An unproven guard is no guard."
fi

# ================================================================= WATCHERS
# All of this happens BEFORE the exec on the last line, because `exec` replaces
# this process and nothing after it ever runs. It is also what was asked for:
# the build keeps the terminal you are standing in, the observers get their own.
# What the run calls itself. The two authority topologies are told apart by the
# fixer, which is the only thing that differs between them.
TOPOLOGY="$WATCH"
if [ "$AUTHORITY" = 1 ]; then
  TOPOLOGY=full-auto
  [ "$WATCH" = watch-fix ] && TOPOLOGY=all
fi
# NOT under ~/.claude. Two independent reasons, and the first is a hard block:
#  1. Claude Code classifies everything under ~/.claude as a SENSITIVE path and
#     refuses a --restricted session's write there — measured, with an explicit
#     allow rule in place: "Claude requested permissions to edit
#     ~/.claude/observations/... which is a sensitive file." An observer whose
#     notebook lives there cannot write its notebook, so the feature cannot
#     work there at all.
#  2. Documents a human reads and scaffolding a machine writes have different
#     lifetimes and different owners, so they get different directories.
OBS="$HOME/claude-build/observations"     # documents a person reads
STATE_DIR="" ; BUILD_SESSION_NAME="" ; BUILD_SID=""
WATCH_SESSION_NAME="" ; FIX_SESSION_NAME=""

render_tpl() {  # render_tpl <template-basename> <out-path>
  local out
  out="$(TPL="$TPL_DIR/$1" OUT_PATH="$2" python3 -c "$PY_RENDER")" || true
  case "$out" in
    OK:*)    return 0 ;;
    FATAL:*) die "${out#FATAL:}" ;;
    *)       die "rendering $1 failed: ${out:-no output}" ;;
  esac
}

# A session is proven up by the REGISTRY, never by the launcher's own optimism.
# ~/.claude/sessions/<pid>.json appears ~5-8s after a launch and is removed
# within ~6s of the process dying, so it is the one readback that distinguishes
# "started" from "started and still alive".
wait_registered() {  # wait_registered <tmux-name> <session-id>
  local i=0
  while [ "$i" -lt 45 ]; do
    grep -qs -F -- "$2" "$HOME"/.claude/sessions/*.json 2>/dev/null && return 0
    # TRAP: a fresh cwd sits on "Quick safety check: Is this a project you
    # created or one you trust?" forever, producing an empty pane and no
    # registry entry. Answer it — once, and only while it is actually on
    # screen — for a directory this run named or this script created.
    if tmux capture-pane -p -t "$1" 2>/dev/null | grep -q "Quick safety check"; then
      tmux send-keys -t "$1" Down
      sleep 1
      tmux send-keys -t "$1" Enter
      warn "answered the workspace-trust dialog for $1"
    fi
    tmux has-session -t "$1" 2>/dev/null || return 2
    sleep 2
    i=$((i + 1))
  done
  return 1
}

if [ -n "$WATCH" ]; then
  step "6. Watchers ($TOPOLOGY)"

  RUN_TAG="$(date +%Y%m%d-%H%M%S)"
  SLUG="$(printf '%s' "$NAME" | tr -c 'A-Za-z0-9-' '-' | cut -c1-20)"
  RUN_ID="$SLUG-$RUN_TAG"
  STATE_DIR="$RUNS/$RUN_ID"
  SHIFT_ID="W$(date +%m%d%H%M)"
  PROJ_ROOT="$HOME/.claude/projects"

  # Identity is ASSIGNED, never discovered. --session-id fixes the transcript
  # name and -n fixes the messaging address, so every session's transcript path
  # is known before any of them boots. The manual watchdog this replaces found
  # its build by `ps | grep` and then guessed the transcript by ranking *.jsonl
  # on mtime; the pid<->transcript binding was never actually observed, and its
  # own log records the cost: a stale pid "would have sent a watchdog to monitor
  # a corpse". `-n` does NOT enforce uniqueness, so the timestamp is what makes
  # these names unambiguous.
  BUILD_SID="$(python3 -c 'import uuid;print(uuid.uuid4())')"
  WATCH_SID="$(python3 -c 'import uuid;print(uuid.uuid4())')"
  FIX_SID="$(python3 -c 'import uuid;print(uuid.uuid4())')"
  BUILD_SESSION_NAME="cb-build-$RUN_ID"
  WATCH_SESSION_NAME="cb-watch-$RUN_ID"
  FIX_SESSION_NAME="cb-fix-$RUN_ID"
  # exec() keeps the pid, so the build session's pid is THIS script's pid.
  BUILD_PID=$$
  BUILD_TRANSCRIPT="$PROJ_ROOT/$(printf '%s' "$DIR" | tr '/._' '---')/$BUILD_SID.jsonl"
  HARNESS_DOC="$OBS/swarm-loop-HARNESS-OPEN.md"
  BUILD_DOC="$OBS/swarm-loop-BUILD-$SLUG-OPEN.md"
  WORK_DIR=""
  [ "$WATCH" = watch-fix ] && WORK_DIR="$STATE_DIR/skill"
  # The approvals store. It must sit OUTSIDE every directory the build session
  # is granted — that is what makes "read-only watcher" and "can issue
  # approvals" compatible instead of contradictory: the builder cannot read,
  # write or even list a path outside its working directories, so it can ask
  # but never grant, and never forge a grant. approvals.log is append-only and
  # is the record that makes the observer-authorizing-its-own-suggestion loop
  # auditable after the fact, since no agent can reliably introspect its own
  # influence. See references/watch-sessions.md.
  CTO_DIR="$STATE_DIR/authority"
  CTO_LOG="$CTO_DIR/approvals.log"
  FIX_LABEL="(none — watch topology)"
  [ "$WATCH" = watch-fix ] && FIX_LABEL="$FIX_SESSION_NAME"
  CTO_LABEL="(none — no authorization gate in this topology)"
  [ "$CTO_ROLE" = watchdog ] && CTO_LABEL="you, in addition to watching"
  # Whether claude-build itself starts the build. Under --no-launch it does not,
  # and BUILD_PID/BUILD_TRANSCRIPT in the ledger are then a PREDICTION about a
  # session a human has yet to start. Without this the watchdog cannot tell
  # "not started yet" from "started and died" — and on the first live run one
  # filed exactly that CRITICAL against a --no-launch run, reasoning correctly
  # from what it had been given. (W09030034-01.)
  if [ "$LAUNCH" = 1 ]; then
    BUILD_LAUNCHED=yes
    BUILD_STATUS="claude-build starts the build itself, immediately after this. Expect its registry entry within about 5-8 seconds."
  else
    BUILD_LAUNCHED=no
    BUILD_STATUS="claude-build was run with --no-launch and did NOT start the build. A human must run the printed command. Until they do, the build is absent from the registry, its transcript does not exist, and the pid above is a PREDICTION, not an observation. That absence is EXPECTED and is not a finding — wait for it rather than reporting it."
  fi

  if [ "$DRY" = 1 ]; then
    echo "  would create   $STATE_DIR"
    echo "  would seed     $HARNESS_DOC"
    echo "  would seed     $BUILD_DOC"
    echo "  would start    tmux session $WATCH_SESSION_NAME  (watchdog, read-only profile)"
    [ "$WATCH" = watch-fix ] && echo "  would copy     $SKILL -> $WORK_DIR"
    [ "$WATCH" = watch-fix ] && echo "  would start    tmux session $FIX_SESSION_NAME  (fixer, writes only its copy)"
    echo "  would bind     the build session to -n $BUILD_SESSION_NAME"
    [ "$AUTHORITY" = 1 ] && echo "  would arm      the CTO authorization gate ($GATE_SENTINEL is declared in the guard)"
    [ "$CTO_ROLE" = watchdog ] && echo "  would give     the CTO role to the watchdog, with an append-only approvals log at $CTO_LOG"
    echo "  nothing was written and no session was started (--dry-run)"
  else
    mkdir -p "$STATE_DIR" "$OBS" "$RUNS" "$PROJ_ROOT"
    if [ -n "$CTO_ROLE" ]; then
      mkdir -p "$CTO_DIR"
      [ -f "$CTO_LOG" ] || printf '# claude-build approvals — append only, one record per line.\n# Each record carries the REQUESTING session, the exact operation, the\n# CTO reason, and a timestamp. It exists so an approval that traces back\n# to the CTO own earlier suggestion can be found after the fact.\n' > "$CTO_LOG"
      ok "approvals store: $CTO_LOG (outside every directory the build can reach)"
    fi

    export T_RUN_ID="$RUN_ID"          T_RUN_TAG="$RUN_TAG"
    export T_MODE="$TOPOLOGY"          T_PROJECT="$NAME"
    export T_DIR="$DIR"                T_WT="$WT"
    export T_OBS="$OBS"                T_STATE_DIR="$STATE_DIR"
    export T_SKILL="$SKILL"            T_SHIFT="$SHIFT_ID"
    export T_BUILD_NAME="$BUILD_SESSION_NAME"   T_BUILD_SID="$BUILD_SID"
    export T_BUILD_PID="$BUILD_PID"    T_BUILD_TRANSCRIPT="$BUILD_TRANSCRIPT"
    export T_WATCH_NAME="$WATCH_SESSION_NAME"   T_WATCH_SID="$WATCH_SID"
    export T_FIX_NAME="$FIX_LABEL"     T_FIX_SID="$FIX_SID"
    export T_HARNESS_DOC="$HARNESS_DOC" T_BUILD_DOC="$BUILD_DOC"
    export T_WORK_DIR="$WORK_DIR"  T_BUILD_STATUS="$BUILD_STATUS"
    export T_CTO_ROLE="$CTO_LABEL" T_CTO_DIR="$CTO_DIR" T_CTO_LOG="$CTO_LOG"

    # Seed each document only if it is not already there. The harness doc is
    # machine-global and long-lived; the build doc is per project. Neither lives
    # in the project repo, so nothing a watcher writes can reach the build's git
    # or the frozen-path blast radius.
    [ -f "$HARNESS_DOC" ] || { render_tpl obs-harness.md "$HARNESS_DOC"; ok "seeded $HARNESS_DOC"; }
    [ -f "$BUILD_DOC" ]   || { render_tpl obs-build.md   "$BUILD_DOC";   ok "seeded $BUILD_DOC"; }

    RJ="$(OUT_PATH="$STATE_DIR/run.json" \
          R_RUN_ID="$RUN_ID" R_RUN_TAG="$RUN_TAG" R_TOPOLOGY="$TOPOLOGY" \
          R_AUTHORITY="$AUTHORITY" R_SHIFT="$SHIFT_ID" R_PROJECT="$NAME" \
          R_DIR="$DIR" R_WORKTREE_ROOT="$WT" R_SKILL="$SKILL" \
          R_STATE_DIR="$STATE_DIR" R_OBS_DIR="$OBS" \
          R_HARNESS_DOC="$HARNESS_DOC" R_BUILD_DOC="$BUILD_DOC" \
          R_BUILD_SESSION_NAME="$BUILD_SESSION_NAME" R_BUILD_SESSION_ID="$BUILD_SID" \
          R_BUILD_PID="$BUILD_PID" R_BUILD_TRANSCRIPT="$BUILD_TRANSCRIPT" \
          R_WATCH_SESSION_NAME="$WATCH_SESSION_NAME" R_WATCH_SESSION_ID="$WATCH_SID" \
          R_FIX_SESSION_NAME="$FIX_LABEL" R_FIX_SESSION_ID="$FIX_SID" \
          R_WORK_DIR="$WORK_DIR" R_BUILD_LAUNCHED="$BUILD_LAUNCHED" \
          R_CTO_ROLE="$CTO_ROLE" R_CTO_DIR="$CTO_DIR" R_CTO_LOG="$CTO_LOG" \
          R_CREATED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
          python3 -c "$PY_RUNJSON")" || true
    case "$RJ" in OK:*) ok "ledger $STATE_DIR/run.json" ;; *) die "could not write the run ledger: ${RJ:-no output}" ;; esac

    printf '%s\n' "$RUNINFO_PY" > "$STATE_DIR/runinfo.py"
    # Executable and invoked BY PATH, never as `bash <script>`: the watchdog's
    # profile denies every interpreter by name, so `bash x.sh` would be refused
    # while ./x.sh runs through its own shebang.
    for h in peers wait-build wait-harness; do
      printf '#!/bin/sh\nexec python3 "%s/runinfo.py" %s "$@"\n' "$STATE_DIR" "$h" > "$STATE_DIR/$h.sh"
      chmod +x "$STATE_DIR/$h.sh"
    done
    ok "watch helpers (peers.sh, wait-build.sh, wait-harness.sh)"

    render_tpl watchdog-prompt.md "$STATE_DIR/watchdog-prompt.txt"
    SET_OUT="$(ROLE=watchdog OUT_PATH="$STATE_DIR/watchdog-settings.json" \
               DIR="$DIR" WT="$WT" OBS="$OBS" STATE_DIR="$STATE_DIR" \
               PROJECTS_DIR="$PROJ_ROOT" SKILL="$SKILL" GUARD="$GUARD" WORK_DIR="" \
               CTO_ROLE="$CTO_ROLE" CTO_DIR="$CTO_DIR" \
               python3 -c "$PY_WATCH_SETTINGS")" || true
    case "$SET_OUT" in OK:*) ok "watchdog profile — ${SET_OUT#OK:}" ;; *) die "watchdog profile failed: ${SET_OUT:-no output}" ;; esac

    # The observer's write boundary, and why each flag is the one it is.
    #
    # run-permissions.md: this script shells out to the CLI, so every session it
    # starts is OUTSIDE the build's git-guard unless provisioned. Both observers
    # are provisioned — same guard, same matcher — and the watchdog is
    # additionally read-only by construction.
    #
    # --restricted   ignores user/project/local settings so nothing widens this
    #                profile from inside, confines the file tools to the working
    #                directories, and refuses bypassPermissions.
    # --tools        omits Task/Agent. The watchdog's fan-out cap is therefore
    #                ZERO and structural, not a sentence in a prompt it can talk
    #                itself out of — measured: with Task unnamed, no Agent tool
    #                is present at all.
    # acceptEdits    NOT `dontAsk`: measured, dontAsk refuses EVERY file write
    #                including the observer's own notebook, with an explicit
    #                allow rule in place, so a dontAsk watchdog cannot file
    #                anything. NOT `plan`: a plan-mode session refuses
    #                SendMessage, so a plan-mode watchdog cannot talk to anyone.
    #                The writes that matter are shut by path denies instead.
    cat > "$STATE_DIR/watchdog-launch.sh" <<LAUNCH_EOF
#!/bin/bash
# started by claude-build $RUN_ID — see run.json in this directory
exec claude --restricted \\
  --add-dir "$DIR" "$WT" "$OBS" "$STATE_DIR" "$PROJ_ROOT" "$SKILL" \\
  --tools "Read,Glob,Grep,Write,Edit,Bash,Monitor,SendMessage,ListAgents" \\
  --permission-mode acceptEdits \\
  --settings "$STATE_DIR/watchdog-settings.json" \\
  -n "$WATCH_SESSION_NAME" \\
  --session-id "$WATCH_SID" \\
  "\$(cat "$STATE_DIR/watchdog-prompt.txt")"
LAUNCH_EOF
    chmod +x "$STATE_DIR/watchdog-launch.sh"

    tmux new-session -d -s "$WATCH_SESSION_NAME" -c "$DIR" "bash $STATE_DIR/watchdog-launch.sh"
    RC=0; wait_registered "$WATCH_SESSION_NAME" "$WATCH_SID" || RC=$?
    case "$RC" in
      0) ok "watchdog registered — $WATCH_SESSION_NAME (tmux: $WATCH_SESSION_NAME)" ;;
      2) die "the watchdog's tmux session died before it registered. Read $STATE_DIR/watchdog-launch.sh and run it by hand to see why." ;;
      *) die "the watchdog never appeared in ~/.claude/sessions/ within 90s — refusing to launch an unwatched build. Inspect it with: tmux attach -t $WATCH_SESSION_NAME   (tear down: bash $STATE_DIR/teardown.sh)" ;;
    esac

    if [ "$WATCH" = watch-fix ]; then
      # The fixer edits a COPY. The live skill is the measuring apparatus of a
      # build that is running right now, and editing it mid-run changes the
      # instrument during the measurement. The suite locates itself by relative
      # path (tests/run.sh says so), so the copy is fully testable. Its profile
      # additionally DENIES edits to $SKILL, so this is enforced twice.
      cp -R "$SKILL" "$WORK_DIR"
      cp -R "$SKILL" "$STATE_DIR/skill-baseline"
      ok "skill copied to $WORK_DIR ($(du -sk "$WORK_DIR" | cut -f1) KB) + pristine baseline"
      # The only way the fixer can execute the suite. It has no interpreter of
      # its own, so this wrapper is the whole of its ability to run code — and
      # it can only run it inside the copy.
      printf '#!/bin/sh\nexec bash "%s/tests/run.sh" "$@"\n' "$WORK_DIR" > "$STATE_DIR/run-tests.sh"
      chmod +x "$STATE_DIR/run-tests.sh"
      render_tpl fixer-prompt.md "$STATE_DIR/fixer-prompt.txt"
      SET_OUT="$(ROLE=fixer OUT_PATH="$STATE_DIR/fixer-settings.json" \
                 DIR="$DIR" WT="$WT" OBS="$OBS" STATE_DIR="$STATE_DIR" \
                 PROJECTS_DIR="$PROJ_ROOT" SKILL="$SKILL" GUARD="$GUARD" WORK_DIR="$WORK_DIR" \
                 CTO_ROLE="$CTO_ROLE" CTO_DIR="$CTO_DIR" \
                 python3 -c "$PY_WATCH_SETTINGS")" || true
      case "$SET_OUT" in OK:*) ok "fixer profile — ${SET_OUT#OK:}" ;; *) die "fixer profile failed: ${SET_OUT:-no output}" ;; esac

      cat > "$STATE_DIR/fixer-launch.sh" <<LAUNCH_EOF
#!/bin/bash
# started by claude-build $RUN_ID — see run.json in this directory
exec claude --restricted \\
  --add-dir "$WORK_DIR" "$STATE_DIR" "$OBS" "$DIR" "$WT" \\
  --tools "Read,Glob,Grep,Write,Edit,Bash,Monitor,SendMessage,ListAgents" \\
  --permission-mode acceptEdits \\
  --settings "$STATE_DIR/fixer-settings.json" \\
  -n "$FIX_SESSION_NAME" \\
  --session-id "$FIX_SID" \\
  "\$(cat "$STATE_DIR/fixer-prompt.txt")"
LAUNCH_EOF
      chmod +x "$STATE_DIR/fixer-launch.sh"

      tmux new-session -d -s "$FIX_SESSION_NAME" -c "$WORK_DIR" "bash $STATE_DIR/fixer-launch.sh"
      RC=0; wait_registered "$FIX_SESSION_NAME" "$FIX_SID" || RC=$?
      case "$RC" in
        0) ok "fixer registered — $FIX_SESSION_NAME (tmux: $FIX_SESSION_NAME)" ;;
        2) die "the fixer's tmux session died before it registered. Read $STATE_DIR/fixer-launch.sh and run it by hand to see why." ;;
        *) die "the fixer never appeared in ~/.claude/sessions/ within 90s. Inspect it with: tmux attach -t $FIX_SESSION_NAME   (tear down: bash $STATE_DIR/teardown.sh)" ;;
      esac
    fi

    TEARDOWN_NAMES="$WATCH_SESSION_NAME"
    [ "$WATCH" = watch-fix ] && TEARDOWN_NAMES="$WATCH_SESSION_NAME $FIX_SESSION_NAME"
    {
      printf '#!/bin/sh\n# teardown for claude-build run %s. Kills the watcher\n' "$RUN_ID"
      printf '# sessions this run started, then READS THE REGISTRY BACK: a kill\n'
      printf '# that is only asserted is not a teardown. The build session is\n'
      printf '# deliberately NOT touched — peer sessions are out of scope.\n'
      printf 'for s in %s; do\n' "$TEARDOWN_NAMES"
      printf '  tmux kill-session -t "$s" 2>/dev/null && echo "killed $s" || echo "not running: $s"\n'
      printf 'done\n'
      printf 'sleep 8\n'
      printf 'echo "registry readback (a dead session leaves within ~6s):"\n'
      printf 'python3 "%s/runinfo.py" peers\n' "$STATE_DIR"
    } > "$STATE_DIR/teardown.sh"
    chmod +x "$STATE_DIR/teardown.sh"
    ok "teardown script: bash $STATE_DIR/teardown.sh"
    [ "$AUTHORITY" = 1 ] && ok "CTO authorization gate armed ($GATE_SENTINEL found in the guard)"
  fi
fi

step "7. Launch"
PROMPT="Use the swarm-loop skill to run an autonomous build in this directory."
[ -n "$SPEC" ]        && PROMPT="$PROMPT The spec is at: $SPEC."
[ -n "$AUDIT_LOOPS" ] && PROMPT="$PROMPT Use $AUDIT_LOOPS audit-fix loops."
[ -n "$MAX_CYCLES" ]  && PROMPT="$PROMPT Use --max-cycles $MAX_CYCLES."
PROMPT="$PROMPT Worktrees for this run go in $WT — Phase 0 is already provisioned: .claude/settings.local.json exists, the git-guard hook is live and probed, and that worktree directory is granted. Do not re-install the hook; verify and continue."
if [ -n "$WATCH" ]; then
  PROMPT="$PROMPT A WATCHDOG session (name: $WATCH_SESSION_NAME) is observing this run from its own terminal; it is read-only with respect to this repository and files what it sees under $OBS. It is not part of your swarm and you do not manage it. Note that its name says 'watch' and NOT 'audit-fix' on purpose: --audit-loops is your act two, running inside THIS session, and is a different mechanism from these watcher sessions."
  [ "$WATCH" = watch-fix ] && PROMPT="$PROMPT A FIXER session (name: $FIX_SESSION_NAME) may repair the skill in a copy at $WORK_DIR; it never touches this repository. The run ledger is $STATE_DIR/run.json."
  # The ONE channel that survives the exec. Everything claude-build printed
  # about the watchers is wiped when Claude Code clears the screen, and the
  # operator is then looking at a single window with no way to learn that two
  # more sessions exist. Your first message is the first thing they will see,
  # so it carries the attach commands.
  PROMPT="$PROMPT BEFORE you begin, your FIRST message must tell the user, verbatim and on their own lines, how to reach the other sessions this run started — they are DETACHED tmux sessions, so the user is looking at one window and cannot otherwise discover them: 'watchdog:  tmux attach -t $WATCH_SESSION_NAME'"
  [ "$WATCH" = watch-fix ] && PROMPT="$PROMPT and 'fixer:     tmux attach -t $FIX_SESSION_NAME'"
  PROMPT="$PROMPT and 'detach with ctrl-b d; list them again any time with claude-build --sessions'. Say it once, at the top, then continue with the build."
fi

# ONE array, used both by the --no-launch instructions and by the exec below.
# These two used to be separate literals, so a flag added to one drifted from
# the other and the printed instructions stopped describing the real launch.
LAUNCH_ARGS=(--add-dir "$WT")
if [ -n "$WATCH" ]; then
  LAUNCH_ARGS+=(-n "$BUILD_SESSION_NAME" --session-id "$BUILD_SID")
fi

# The watchers get launch scripts because they are started INTO tmux. The build
# is not: it is exec'd into the terminal this script was run from, which is why
# BUILD_PID is $$. Write the command down anyway. Without it a run directory
# holds a pid, a session id and a transcript path with no record of what was
# actually run, and "the build never started" cannot be told apart from "the
# build started and exited" — which is exactly the ambiguity the first live run
# hit. This file is a RECORD; claude-build never executes it. (W09030034-02.)
if [ -n "$WATCH" ] && [ "$DRY" != 1 ]; then
  printf '%s\n' "$PROMPT" > "$STATE_DIR/build-prompt.txt"
  {
    printf '#!/bin/bash\n'
    printf '# claude-build %s — a RECORD of how the build session was started.\n' "$RUN_ID"
    printf '# claude-build does NOT run this file. Running it by hand starts a\n'
    printf '# SECOND build against the same run directory.\n'
    printf 'export CLAUDE_BUILD_STATE_DIR=%q\n' "$STATE_DIR"
    printf 'cd %q\n' "$DIR"
    printf 'exec claude'
    for a in "${LAUNCH_ARGS[@]}"; do printf ' %q' "$a"; done
    printf ' "$(cat %q)"\n' "$STATE_DIR/build-prompt.txt"
  } > "$STATE_DIR/build-launch.sh"
  chmod +x "$STATE_DIR/build-launch.sh"
  ok "build command recorded: $STATE_DIR/build-launch.sh"
fi

if [ "$LAUNCH" = 0 ]; then
  [ "$DRY" = 1 ] || ok "configured — not launching the build (--no-launch)"
  PRINTED_ARGS=""
  for a in "${LAUNCH_ARGS[@]}"; do PRINTED_ARGS="$PRINTED_ARGS $(printf '%q' "$a")"; done
  ENV_PREFIX=""
  [ -n "$WATCH" ] && ENV_PREFIX="CLAUDE_BUILD_STATE_DIR=$(printf '%q' "$STATE_DIR") "
  cat <<EOF

Start it yourself with:
  cd "$DIR" && ${ENV_PREFIX}claude${PRINTED_ARGS}

Then say:
  $PROMPT
EOF
  if [ -n "$WATCH" ] && [ "$DRY" != 1 ]; then
    cat <<EOF

The watchers are ALREADY RUNNING and are bound to that exact session name and
id, so start the build with the command above rather than a bare \`claude\`.
  watch:     tmux attach -t $WATCH_SESSION_NAME
EOF
    [ "$WATCH" = watch-fix ] && echo "  fixer:     tmux attach -t $FIX_SESSION_NAME"
    echo "  tear down: bash $STATE_DIR/teardown.sh"
  fi
  exit 0
fi

ok "starting Claude Code in $DIR"
if [ -n "$WATCH" ]; then
  # The seam the authorization gate will use: the build session inherits this,
  # so a hook running inside it can read the run ledger and learn who the CTO
  # is without any discovery heuristic.
  export CLAUDE_BUILD_STATE_DIR="$STATE_DIR"
  echo
  echo "  watchdog:  tmux attach -t $WATCH_SESSION_NAME"
  [ "$WATCH" = watch-fix ] && echo "  fixer:     tmux attach -t $FIX_SESSION_NAME"
  echo "  tear down: bash $STATE_DIR/teardown.sh"
fi
cd "$DIR"
exec claude "${LAUNCH_ARGS[@]}" "$PROMPT"
