#!/usr/bin/env bash
# claude-build — open a Claude Code session preconfigured for a swarm-loop run.
#
# Solves the failure that makes every other guard-fix moot: Claude Code reads
# .claude/settings.local.json at SESSION START. A settings file created mid-session
# is never picked up (measured on 2.1.252), so a run that installs its own git-guard
# after launching has no guard at all for the first mutating wave. This script writes
# the file, PROVES the hook is live, and only then launches the session.
#
# Everything it writes is recorded in .claude/.claude-build.json, so --uninstall
# removes exactly what was added and nothing you added yourself.
#
# Usage:  claude-build [DIR] [options]        Run with --help for options.

set -euo pipefail

SKILL="$HOME/.claude/skills/swarm-loop"
GUARD="$SKILL/hooks/git-guard.py"
HARNESS="$SKILL/scripts/swarmloop.py"
SELF="${BASH_SOURCE[0]}"

DIR="" ; SPEC="" ; AUDIT_LOOPS="" ; MAX_CYCLES=""
LAUNCH=1 ; IN_TREE=0 ; DRY=0 ; QUIET=0 ; MODE=install ; PURGE=0

die()  { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }
ok()   { [ "$QUIET" = 1 ] || printf '  \033[32m✓\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*" >&2; }
step() { [ "$QUIET" = 1 ] || printf '\n\033[1m%s\033[0m\n' "$*"; }

# macOS ships bash 3.2, whose parser scans a heredoc body for quotes when the
# heredoc sits inside $( ... ) — one apostrophe in a Python comment then breaks
# the whole script. Define these at top level and pass them with -c instead.
read -r -d '' PY_MERGE <<'PY_MERGE_EOF' || true
import json, os, sys

path, wt, dry = os.environ["SETTINGS"], os.environ["WT"], os.environ["DRY"] == "1"
manifest_p = os.environ["MANIFEST"]
cmd = 'python3 "$HOME/.claude/skills/swarm-loop/hooks/git-guard.py"'

data, note = {}, []
if os.path.exists(path):
    try:
        with open(path) as f:
            data = json.load(f) or {}
        note.append("merged into existing settings.local.json")
    except Exception as e:
        print(f"FATAL:existing {path} is not valid JSON ({e}) — fix or move it first")
        sys.exit(3)
else:
    note.append("created settings.local.json")

# The manifest is the ONLY record of what uninstall has to undo. It used to be
# rebuilt from scratch and written unconditionally, so a SECOND install erased
# the first one's record: uninstall then no longer knew it had added
# Read(.env)/Edit(.env) or the worktree grant, and left them behind forever.
# Load the previous manifest and MERGE into it instead of overwriting.
prev = {}
if os.path.exists(manifest_p):
    try:
        with open(manifest_p) as f:
            prev = json.load(f) or {}
        note.append("merged into existing install manifest")
    except Exception:
        note.append("existing manifest unreadable — starting a fresh one")
        prev = {}

man = dict(prev)
man["permissions_added"] = list(prev.get("permissions_added") or [])
man["additional_directories_added"] = list(prev.get("additional_directories_added") or [])
man["gitignore_added"] = list(prev.get("gitignore_added") or [])
man.setdefault("set_disable_all_hooks", False)
if prev.get("worktree_dir") and prev["worktree_dir"] != wt:
    note.append("worktree dir changed (%s -> %s); --purge only removes the new one"
                % (prev["worktree_dir"], wt))
man["worktree_dir"] = wt

# Hook entries MERGE across settings levels, so this never removes a user-level
# hook. disableAllHooks is the one switch that turns the guard off; pin it false.
#
# A user's own "disableAllHooks": true used to be flipped to false and only
# NOTED — set_disable_all_hooks stayed False, so the restore in --uninstall
# never fired and our flip was permanent. Record the prior state so uninstall
# can put it back. Record it ONCE: only the FIRST install sees the user's real
# value; every later one sees nothing but our own pin.
had_dah = "disableAllHooks" in data
if "disable_all_hooks_was_present" not in prev:
    man["disable_all_hooks_was_present"] = had_dah
    man["disable_all_hooks_prev"] = data.get("disableAllHooks")
    man["set_disable_all_hooks"] = not had_dah  # legacy field; older uninstallers read it
if had_dah and data.get("disableAllHooks") is True:
    note.append("flipped disableAllHooks true -> false (uninstall restores it)")
data["disableAllHooks"] = False

hooks = data.setdefault("hooks", {})
pre = hooks.setdefault("PreToolUse", [])
if not isinstance(pre, list):
    print("FATAL:hooks.PreToolUse is not a list — fix settings.local.json by hand")
    sys.exit(3)

def has_guard(entries):
    for e in entries:
        if isinstance(e, dict):
            for h in e.get("hooks") or []:
                if isinstance(h, dict) and "git-guard.py" in str(h.get("command", "")):
                    return True
    return False

if has_guard(pre):
    note.append("git-guard hook already present (left as-is)")
else:
    pre.append({"matcher": "Bash|Edit|Write|NotebookEdit|MultiEdit", "hooks": [{"type": "command", "command": cmd}]})
    note.append("added git-guard PreToolUse hook")

perms = data.setdefault("permissions", {})
adds = perms.get("additionalDirectories")
if not isinstance(adds, list):
    adds = []
if wt not in adds and not wt.startswith(os.path.dirname(os.path.dirname(path))+os.sep+".claude"):
    adds.append(wt)
    if wt not in man["additional_directories_added"]:  # union — see manifest note above
        man["additional_directories_added"].append(wt)
    note.append("granted worktree directory")
perms["additionalDirectories"] = adds

# Baseline allowlist: capability the swarm needs to not hang on a prompt, and
# nothing deploy-adjacent. Add project-specific Bash patterns yourself — a
# permission entry never widens a task packet's boundary.
baseline = [
    "Bash(git worktree add:*)", "Bash(git worktree list:*)", "Bash(git worktree prune:*)",
    "Bash(git merge:*)", "Bash(git branch:*)", "Bash(git commit:*)", "Bash(git add:*)",
    "Read(.env)", "Read(.env.*)", "Edit(.env)", "Edit(.env.*)",
]
allow = perms.get("allow")
if not isinstance(allow, list):
    allow = []
added = [p for p in baseline if p not in allow]
allow.extend(added)
# Union, never replace: on a second install `added` is empty because the first
# install already put these in allow[], and assigning it would blank the record
# that uninstall uses to take them back out.
for p in added:
    if p not in man["permissions_added"]:
        man["permissions_added"].append(p)
perms["allow"] = allow
if added:
    note.append(f"added {len(added)} baseline permission(s)")

if not dry:
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2); f.write("\n")
    os.replace(tmp, path)
    with open(manifest_p, "w") as f:
        json.dump(man, f, indent=2); f.write("\n")

print("OK:" + "; ".join(note))
PY_MERGE_EOF

read -r -d '' PY_UNINSTALL <<'PY_UNINSTALL_EOF' || true
import json, os, sys

settings, manifest_p, root = os.environ["SETTINGS"], os.environ["MANIFEST"], os.environ["DIR"]
dry = os.environ["DRY"] == "1"
notes, wt = [], None

man = {}
if os.path.exists(manifest_p):
    try:
        with open(manifest_p) as f:
            man = json.load(f) or {}
        notes.append("read manifest")
    except Exception:
        notes.append("manifest unreadable — falling back to signature matching")
else:
    notes.append("no manifest — falling back to signature matching")

wt = man.get("worktree_dir")
added_perms = set(man.get("permissions_added") or [])
added_dirs  = set(man.get("additional_directories_added") or ([wt] if wt else []))
added_gi    = man.get("gitignore_added") or []

if os.path.exists(settings):
    try:
        with open(settings) as f:
            data = json.load(f) or {}
    except Exception as e:
        print(f"FATAL:{settings} is not valid JSON ({e}) — remove entries by hand")
        sys.exit(3)

    # Hook: always signature-matched. Only entries pointing at OUR guard go.
    hooks = data.get("hooks") or {}
    pre = hooks.get("PreToolUse")
    if isinstance(pre, list):
        kept = []
        removed = 0
        for e in pre:
            if isinstance(e, dict):
                inner = [h for h in (e.get("hooks") or [])
                         if not (isinstance(h, dict) and "git-guard.py" in str(h.get("command", "")))]
                if len(inner) != len(e.get("hooks") or []):
                    removed += 1
                    if inner:
                        e = dict(e, hooks=inner); kept.append(e)
                    continue
            kept.append(e)
        if removed:
            notes.append(f"removed {removed} git-guard hook entr" + ("y" if removed == 1 else "ies"))
        if kept:
            hooks["PreToolUse"] = kept
        else:
            hooks.pop("PreToolUse", None)
        if hooks:
            data["hooks"] = hooks
        else:
            data.pop("hooks", None)

    # disableAllHooks: we set it False. Touch it only if it is STILL exactly
    # False — if the user turned it back on since install, that is their call.
    # Restore whatever was there before install: absent -> remove the key,
    # true -> put the true back. The old code only ever removed the key, so a
    # user who had hooks disabled had that setting silently flipped for good.
    if data.get("disableAllHooks") is False:
        if "disable_all_hooks_was_present" in man:
            if man.get("disable_all_hooks_was_present"):
                prior = man.get("disable_all_hooks_prev")
                if prior is not False:
                    data["disableAllHooks"] = prior
                    notes.append("restored disableAllHooks = " + json.dumps(prior))
            else:
                data.pop("disableAllHooks", None)
                notes.append("removed disableAllHooks pin")
        elif man.get("set_disable_all_hooks"):  # manifest from an older install
            data.pop("disableAllHooks", None)
            notes.append("removed disableAllHooks pin")

    perms = data.get("permissions") or {}
    ad = perms.get("additionalDirectories")
    if isinstance(ad, list) and added_dirs:
        before = len(ad)
        ad = [d for d in ad if d not in added_dirs]
        if len(ad) != before:
            notes.append(f"removed {before - len(ad)} worktree grant(s)")
        if ad: perms["additionalDirectories"] = ad
        else:  perms.pop("additionalDirectories", None)

    allow = perms.get("allow")
    if isinstance(allow, list) and added_perms:
        before = len(allow)
        allow = [p for p in allow if p not in added_perms]
        if len(allow) != before:
            notes.append(f"removed {before - len(allow)} baseline permission(s)")
        if allow: perms["allow"] = allow
        else:     perms.pop("allow", None)

    if perms: data["permissions"] = perms
    else:     data.pop("permissions", None)

    if not dry:
        if data:
            tmp = settings + ".tmp"
            with open(tmp, "w") as f:
                json.dump(data, f, indent=2); f.write("\n")
            os.replace(tmp, settings)
        else:
            os.remove(settings)
            notes.append("settings.local.json was left empty — deleted")
else:
    notes.append("no settings.local.json found")

# .gitignore: remove only lines we added, and only if still present verbatim.
gi = os.path.join(root, ".gitignore")
if added_gi and os.path.exists(gi):
    with open(gi) as f:
        lines = f.read().splitlines()
    keep = []
    dropped = 0
    for ln in lines:
        if ln in added_gi and dropped < len(added_gi):
            dropped += 1
            continue
        keep.append(ln)
    if dropped and not dry:
        with open(gi, "w") as f:
            f.write("\n".join(keep).rstrip("\n") + ("\n" if keep else ""))
    if dropped:
        notes.append(f"removed {dropped} .gitignore line(s)")

if not dry and os.path.exists(manifest_p):
    os.remove(manifest_p)
    notes.append("removed manifest")

print("OK:" + (wt or "") + "|" + "; ".join(notes))
PY_UNINSTALL_EOF

usage() {
  cat <<'HELP_TEXT'
claude-build — open a Claude Code session preconfigured for a swarm-loop run.

USAGE
  claude-build [DIR] [options]
  claude-build [DIR] --uninstall
  claude-build --uninstall-self

ARGUMENTS
  DIR                  Project directory. Default: current directory.
                       Created, and git-initialized, if it does not exist.

OPTIONS
  --spec FILE          Spec / PRD / build-doc to hand the skill on open.
  --audit-loops N      Audit-fix loops after the build converges (default: ask).
  --max-cycles N       Runaway safety ceiling (default: ask).
  --in-tree            Force worktrees to .swarm-loop/worktrees/ instead of a
                       sibling directory. Costs you the metric-contamination
                       protection; see references/run-permissions.md.
  --no-launch          Configure and probe, but do not start Claude Code.
  --dry-run            Show what would change. Writes nothing.
  -q, --quiet          Only warnings and errors.
  -h, --help           This text.

UNINSTALL
  --uninstall          Remove from DIR exactly what claude-build added: the
                       git-guard hook, the worktree grant, the baseline
                       permissions, and its .gitignore lines. Anything you
                       added yourself is left alone. Reads the manifest at
                       .claude/.claude-build.json; falls back to signature
                       matching if that file is gone.
  --purge              With --uninstall only: also delete the worktree
                       directory and prune stale worktree registrations. Takes
                       the directory from the manifest and refuses to guess if
                       the manifest is gone. Refuses if any worktree still holds
                       uncommitted work, or if git cannot say whether it does.
  --uninstall-self     Delete the claude-build script itself. Does not touch
                       any project; run --uninstall in each project first.

WHAT INSTALL DOES
  1. Creates / git-initializes the project directory.
  2. Picks a worktree location outside the repo (so root-walking metric
     commands cannot count in-flight workers' checkouts).
  3. Merges the git-guard hook + permission grants into
     .claude/settings.local.json, non-destructively and idempotently.
  4. PROBES the guard and the worktree grant, and refuses to launch if either
     fails. A guard you did not prove is a guard you do not have.
  5. Launches Claude Code with the worktree directory already granted.
HELP_TEXT
  exit 0
}

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)        usage ;;
    --spec)           SPEC="${2:-}"; shift 2 ;;
    --audit-loops)    AUDIT_LOOPS="${2:-}"; shift 2 ;;
    --max-cycles)     MAX_CYCLES="${2:-}"; shift 2 ;;
    --in-tree)        IN_TREE=1; shift ;;
    --no-launch)      LAUNCH=0; shift ;;
    --dry-run)        DRY=1; LAUNCH=0; shift ;;
    --uninstall)      MODE=uninstall; LAUNCH=0; shift ;;
    --purge)          PURGE=1; shift ;;
    --uninstall-self) MODE=uninstall-self; LAUNCH=0; shift ;;
    -q|--quiet)       QUIET=1; shift ;;
    -*)               die "unknown option: $1  (claude-build --help)" ;;
    *)                [ -n "$DIR" ] && die "more than one directory given: $DIR and $1"
                      DIR="$1"; shift ;;
  esac
done

# --purge is only ever READ under --uninstall. Accepting it silently anywhere
# else means `claude-build ~/proj --purge` reads as "remove the worktrees" and
# does the opposite — a full INSTALL — with no hint that the flag did nothing.
if [ "$PURGE" = 1 ] && [ "$MODE" != uninstall ]; then
  die "--purge only means anything with --uninstall (you asked for: $MODE)"
fi

# ------------------------------------------------------------ uninstall-self
if [ "$MODE" = uninstall-self ]; then
  TARGET="$(cd "$(dirname "$SELF")" && pwd -P)/$(basename "$SELF")"
  step "claude-build — uninstall self"
  warn "this removes the launcher only; per-project config stays until you run"
  warn "  claude-build <dir> --uninstall   in each project you configured"
  if [ "$DRY" = 1 ]; then echo "  would delete: $TARGET"; exit 0; fi
  rm -f "$TARGET" && ok "deleted $TARGET"
  echo
  echo "The swarm-loop skill itself is untouched at $SKILL."
  exit 0
fi

# ---------------------------------------------------------------- preflight
[ -f "$GUARD" ]   || die "git-guard not found at $GUARD — is the swarm-loop skill installed?"
[ -f "$HARNESS" ] || die "swarmloop.py not found at $HARNESS — is the swarm-loop skill installed?"
command -v python3 >/dev/null || die "python3 not on PATH (the guard and harness need it)"
command -v git     >/dev/null || die "git not on PATH"
[ "$MODE" = install ] && { command -v claude >/dev/null || die "claude not on PATH"; }

DIR="${DIR:-$PWD}"
if [ ! -d "$DIR" ]; then
  # Only install mode creates the directory. A missing DIR used to silently
  # fall back to $PWD, so one typo in `claude-build ~/prject --uninstall --purge`
  # pointed the rm -rf and the settings surgery at whatever repo you happened to
  # be standing in. Outside install mode a path that does not exist is an ABORT.
  if [ "$MODE" != install ]; then
    die "no such directory: $DIR  (refusing to fall back to $PWD in $MODE mode)"
  fi
  # if/else, not `A && B || C`: with the && form a failed echo (closed stdout)
  # falls through and creates the directory during a --dry-run.
  if [ "$DRY" = 1 ]; then echo "would create directory: $DIR"; else mkdir -p "$DIR"; fi
fi
if [ -d "$DIR" ]; then
  DIR="$(cd "$DIR" && pwd -P)"
else
  # --dry-run install of a directory that does not exist yet: nothing was
  # created, so make the path absolute without cd-ing into it.
  case "$DIR" in /*) ;; *) DIR="$PWD/${DIR#./}" ;; esac
fi
if git -C "$DIR" rev-parse --show-toplevel >/dev/null 2>&1; then
  ROOT="$(git -C "$DIR" rev-parse --show-toplevel)"
  [ "$ROOT" != "$DIR" ] && { warn "$DIR is inside the repo at $ROOT — using the repo root"; DIR="$ROOT"; }
fi
NAME="$(basename "$DIR")"
SETTINGS="$DIR/.claude/settings.local.json"
MANIFEST="$DIR/.claude/.claude-build.json"

# Is every registered worktree at or under $1 clean enough to delete? Returns 0
# only when the answer is a proven yes.
#
# The old one-liner was
#   git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}' | grep -F "$BASE"
# which is wrong three ways, each of which ends in rm -rf'ing live work:
#   * awk '{print $2}' truncates a worktree path at its first space, so a
#     checkout under "/Users/me/My Proj-worktrees/t1" was never status-checked;
#   * grep -F substring-matches, so "…-worktrees.bak/t1" counted as ours while
#     the truncated paths above matched nothing at all;
#   * 2>/dev/null on both git calls made the check fail OPEN — a git that could
#     not answer read as "all clean, go ahead".
# So: split on the `worktree ` sentinel (paths keep their spaces), match the base
# exactly, and fail CLOSED when git cannot answer.
wt_clean() {
  local base="$1" listing line w st rc=0
  if ! listing="$(git -C "$DIR" worktree list --porcelain 2>&1)"; then
    warn "cannot list worktrees in $DIR — git said: ${listing%%$'\n'*}"
    return 1
  fi
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) w="${line#worktree }" ;;
      *)            continue ;;
    esac
    case "$w" in
      "$base"|"$base"/*) ;;
      *)                 continue ;;
    esac
    # A registration whose directory is already gone holds no work to lose —
    # that is precisely what `git worktree prune` below cleans up.
    [ -d "$w" ] || continue
    if ! st="$(git -C "$w" status --porcelain 2>&1)"; then
      warn "cannot read git status in $w — git said: ${st%%$'\n'*}"
      rc=1; continue
    fi
    if [ -n "$st" ]; then
      warn "uncommitted work in $w"; rc=1
    fi
  done <<< "$listing"
  return "$rc"
}

# ================================================================ UNINSTALL
if [ "$MODE" = uninstall ]; then
  step "claude-build — uninstall from $NAME"
  [ "$DRY" = 1 ] && warn "DRY RUN — nothing will be removed"

  # The manifest is the ONLY thing allowed to name a directory we rm -rf. The old
  # code invented "$(dirname "$DIR")/$NAME-worktrees" whenever the manifest was
  # missing or unreadable and then deleted that guess — a directory claude-build
  # may never have created, and may well be someone else's work. Read it here,
  # before the uninstall step deletes the manifest.
  WT_REC="$(MANIFEST="$MANIFEST" python3 -c 'import json,os;p=os.environ["MANIFEST"];print((json.load(open(p)).get("worktree_dir") or "") if os.path.exists(p) else "")' 2>/dev/null || true)"

  # Safety first: if --purge could refuse, it must refuse BEFORE anything is
  # removed. Otherwise a refusal leaves the project half-uninstalled.
  if [ "$PURGE" = 1 ]; then
    [ -n "$WT_REC" ] || die "--purge needs the install manifest at $MANIFEST to know which directory to delete, and it is missing or unreadable. Refusing to guess — rerun without --purge and remove the worktree directory by hand."
    case "$WT_REC" in
      /*) ;;
      *)  die "manifest worktree_dir is not an absolute path ($WT_REC) — refusing to purge" ;;
    esac
    [ "$WT_REC" = "/" ] && die "manifest worktree_dir is / — refusing to purge"
    case "$DIR/" in
      "$WT_REC"/*) die "manifest worktree_dir $WT_REC contains the project $DIR — refusing to purge" ;;
    esac
    wt_clean "$WT_REC" || die "refusing to purge — worktrees under $WT_REC are not all clean, or git could not say. Nothing was removed; commit or discard, then rerun."
  fi

  OUT="$(SETTINGS="$SETTINGS" MANIFEST="$MANIFEST" DIR="$DIR" DRY="$DRY" python3 -c "$PY_UNINSTALL")" || true

  case "$OUT" in
    FATAL:*) die "${OUT#FATAL:}" ;;
    # The wt field before the "|" is the same manifest value already read into
    # WT_REC above; only the notes are consumed here. `for n in "${N[@]}"` is an
    # unbound-variable error on bash 3.2 when NOTES is empty, so guard it.
    OK:*)    BODY="${OUT#OK:}"; NOTES="${BODY#*|}"
             IFS=';' read -ra N <<< "$NOTES"
             for n in ${N[@]+"${N[@]}"}; do ok "${n# }"; done ;;
    *)       die "uninstall failed: ${OUT:-no output}" ;;
  esac

  if [ "$PURGE" = 1 ]; then
    step "Purge — worktrees"
    # Re-checked immediately before the delete: this is the check that actually
    # guards the rm -rf, and the settings surgery above took real time.
    wt_clean "$WT_REC" || die "refusing to purge — worktrees under $WT_REC are not all clean, or git could not say (commit or discard, then rerun)"
    if [ "$DRY" = 1 ]; then echo "  would delete $WT_REC and run git worktree prune"
    else
      rm -rf -- "$WT_REC"
      git -C "$DIR" worktree prune || warn "git worktree prune failed — run it by hand in $DIR"
      ok "deleted $WT_REC and pruned"
    fi
  elif [ -n "$WT_REC" ] && [ -d "$WT_REC" ]; then
    warn "worktree dir left in place: $WT_REC  (--purge removes it)"
  fi

  step "Done"
  echo "  The swarm-loop skill and any .swarm-loop/ run state are untouched."
  echo "  Restart Claude Code for the hook removal to take effect."
  exit 0
fi

# ================================================================== INSTALL
step "claude-build — $NAME"
[ "$DRY" = 1 ] && warn "DRY RUN — nothing will be written"

step "1. Repository"
GIT_ID=(-c "user.email=$(git config user.email 2>/dev/null || echo build@local)"
        -c "user.name=$(git config user.name 2>/dev/null || echo claude-build)")
if git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1; then
  ok "git repo at $DIR"
  if ! git -C "$DIR" rev-parse HEAD >/dev/null 2>&1; then
    if [ "$DRY" = 1 ]; then echo "  would create an initial commit (repo has no HEAD)"
    else git -C "$DIR" "${GIT_ID[@]}" commit -q --allow-empty -m "initial commit"; ok "created initial commit"; fi
  fi
else
  if [ "$DRY" = 1 ]; then echo "  would run: git init -b main; initial commit"
  else
    git -C "$DIR" init -q -b main
    git -C "$DIR" "${GIT_ID[@]}" commit -q --allow-empty -m "initial commit"
    ok "git init -b main + initial commit (greenfield)"
  fi
fi

step "2. Worktree location"
PARENT="$(dirname "$DIR")"
WT="$PARENT/${NAME}-worktrees"; WT_MODE="sibling"
if [ "$IN_TREE" = 1 ]; then
  WT="$DIR/.swarm-loop/worktrees"; WT_MODE="in-tree (forced)"
# The `mkdir -p` below is how this probe learns the parent is really writable,
# but it also CREATES the directory — under --dry-run, which advertises "Writes
# nothing", that left a <name>-worktrees/ behind in the user's parent directory.
# In dry-run mode settle for what can be learned without writing.
elif ! ( [ -w "$PARENT" ] && ( [ -d "$WT" ] || [ "$DRY" = 1 ] || mkdir -p "$WT" 2>/dev/null ) ); then
  WT="$DIR/.swarm-loop/worktrees"; WT_MODE="in-tree (parent not writable)"
  warn "cannot write to $PARENT — falling back in-tree"
  warn "metric commands MUST then exclude .swarm-loop/ (see goal-setting.md)"
fi
[ "$DRY" = 1 ] || mkdir -p "$WT"
ok "$WT_MODE → $WT"

step "3. Settings (.claude/settings.local.json)"
[ "$DRY" = 1 ] || mkdir -p "$DIR/.claude"
MERGE_OUT="$(WT="$WT" SETTINGS="$SETTINGS" MANIFEST="$MANIFEST" DRY="$DRY" python3 -c "$PY_MERGE")" || true
case "$MERGE_OUT" in
  FATAL:*) die "${MERGE_OUT#FATAL:}" ;;
  OK:*)    ok "${MERGE_OUT#OK:}" ;;
  *)       die "settings merge failed: ${MERGE_OUT:-no output}" ;;
esac

# settings.local.json is not the only file that can turn the guard off, and it
# was the only one this script ever looked at. A project .claude/settings.json —
# or the user-level ~/.claude/settings.json — carrying "disableAllHooks": true
# leaves the session with NO hooks at all, and every probe in step 5 still comes
# back green, because those probes pipe JSON straight into git-guard.py and never
# go through the settings harness that reads these files. Four green checks over
# a dead guard is the worst failure this script can produce, so look, say so
# loudly, and let step 5 refuse the launch.
HOOKS_OFF_AT=""
for OTHER in "$DIR/.claude/settings.json" "$HOME/.claude/settings.json"; do
  [ -f "$OTHER" ] || continue
  OTHER_STATE="$(OTHER="$OTHER" python3 -c '
import json, os
try:
    d = json.load(open(os.environ["OTHER"])) or {}
except Exception:
    print("unreadable"); raise SystemExit
print("off" if d.get("disableAllHooks") is True else "ok")' 2>/dev/null || echo unreadable)"
  case "$OTHER_STATE" in
    off) HOOKS_OFF_AT="$OTHER"
         warn "$OTHER sets \"disableAllHooks\": true"
         warn "  that switch kills EVERY hook for the session — including the git-guard"
         warn "  just written to settings.local.json — and it outlives this script."
         warn "  Remove that key from $OTHER, then rerun." ;;
    unreadable) warn "could not parse $OTHER — check it by hand for disableAllHooks" ;;
  esac
done

step "4. .gitignore"
GI="$DIR/.gitignore"
NEEDED='.claude/settings.local.json
.claude/.claude-build.json
.swarm-loop/worktrees/
.swarm-loop/archive/
__pycache__/
*.py[co]
.pytest_cache/
.mypy_cache/'
if [ "$DRY" = 1 ]; then
  echo "  would ensure $(printf '%s\n' "$NEEDED" | wc -l | tr -d ' ') entries in .gitignore"
else
  ADDED_LINES=()
  touch "$GI"
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    grep -qxF "$line" "$GI" 2>/dev/null || { printf '%s\n' "$line" >> "$GI"; ADDED_LINES+=("$line"); }
  done <<< "$NEEDED"
  if [ ${#ADDED_LINES[@]} -gt 0 ]; then
    # Append to the recorded list, do not replace it: a later install that adds
    # one new line used to wipe the first install's record, stranding the rest of
    # the .gitignore entries in the project forever.
    printf '%s\n' "${ADDED_LINES[@]}" | MANIFEST="$MANIFEST" python3 -c '
import json,os,sys
p=os.environ["MANIFEST"]
try:
    m=json.load(open(p)) if os.path.exists(p) else {}
except Exception:
    m={}
seen=m.get("gitignore_added") or []
for l in (x.rstrip("\n") for x in sys.stdin):
    if l.strip() and l not in seen:
        seen.append(l)
m["gitignore_added"]=seen
json.dump(m,open(p,"w"),indent=2)'
  fi
  ok "${#ADDED_LINES[@]} entr$([ ${#ADDED_LINES[@]} = 1 ] && echo y || echo ies) added"
fi

step "5. Probes — proving the configuration, not assuming it"
if [ "$DRY" = 1 ]; then
  echo "  would probe: guard blocks 'git stash' / allows 'git status' / blocks the"
  echo "               multi-line form; worktree add+write+read+teardown at $WT"
else
  probe_guard() {
    printf '%s' "$1" \
      | python3 -c 'import json,sys;print(json.dumps({"tool_name":"Bash","tool_input":{"command":sys.stdin.read()}}))' \
      | python3 "$GUARD" >/dev/null 2>&1
    echo $?
  }
  FAIL=0
  R="$(cd "$DIR" && probe_guard 'git stash')"
  [ "$R" = 2 ] && ok "guard BLOCKS 'git stash' (exit 2)" || { warn "guard did NOT block 'git stash' (exit $R)"; FAIL=1; }
  R="$(cd "$DIR" && probe_guard 'git status --porcelain')"
  [ "$R" = 0 ] && ok "guard ALLOWS 'git status' (exit 0)" || { warn "guard blocked a read-only command (exit $R)"; FAIL=1; }
  R="$(cd "$DIR" && probe_guard $'git status\ngit stash')"
  [ "$R" = 2 ] && ok "guard blocks the multi-line form (exit 2)" || { warn "multi-line bypass is open (exit $R)"; FAIL=1; }

  # A grant covering reads but not writes passes the first half of this and
  # hangs the wave on the second, so probe all four operations.
  #
  # The name is per-process: a fixed "_cb_probe" collides with a second
  # claude-build running against the same repo, and with the leftover branch of
  # any earlier run whose cleanup did not complete — which showed up as a
  # worktree probe FAILURE on a perfectly good repo.
  PROBE_ID="_cb_probe_$$_${RANDOM}"
  PROBE_WT="$WT/$PROBE_ID"
  if ( cd "$DIR" \
       && git worktree add -q "$PROBE_WT" -b "$PROBE_ID" >/dev/null 2>&1 \
       && echo probe > "$PROBE_WT/probe.txt" \
       && [ "$(cat "$PROBE_WT/probe.txt")" = probe ] ); then
    ok "worktree add + write + read at $WT"
  else
    warn "worktree probe FAILED at $WT"; FAIL=1
  fi

  # Teardown used to end in `|| true`, so a probe worktree left registered in the
  # repo — which pollutes every later `git worktree list` and any root-walking
  # metric command — was completely silent. Say what is left behind.
  CLEAN=0
  [ -e "$PROBE_WT" ] && { rm -rf -- "$PROBE_WT" || CLEAN=1; }
  git -C "$DIR" worktree prune >/dev/null 2>&1 || CLEAN=1
  if git -C "$DIR" rev-parse --verify -q "refs/heads/$PROBE_ID" >/dev/null 2>&1; then
    git -C "$DIR" branch -qD "$PROBE_ID" >/dev/null 2>&1 || CLEAN=1
  fi
  if [ "$CLEAN" = 1 ] || [ -e "$PROBE_WT" ]; then
    warn "probe cleanup incomplete — remove $PROBE_WT and branch $PROBE_ID by hand"
  else
    ok "probe worktree + branch torn down"
  fi

  # Green probes prove git-guard.py works; they cannot prove the session will
  # ever call it. See the disableAllHooks scan in step 3.
  if [ -n "$HOOKS_OFF_AT" ]; then
    warn "disableAllHooks: true in $HOOKS_OFF_AT — the probes above cannot see this, and the guard will not run"
    FAIL=1
  fi

  [ "$FAIL" = 1 ] && die "probes failed — refusing to launch. An unproven guard is no guard."
fi

step "6. Launch"
PROMPT="Use the swarm-loop skill to run an autonomous build in this directory."
[ -n "$SPEC" ]        && PROMPT="$PROMPT The spec is at: $SPEC."
[ -n "$AUDIT_LOOPS" ] && PROMPT="$PROMPT Use $AUDIT_LOOPS audit-fix loops."
[ -n "$MAX_CYCLES" ]  && PROMPT="$PROMPT Use --max-cycles $MAX_CYCLES."
PROMPT="$PROMPT Worktrees for this run go in $WT — Phase 0 is already provisioned: .claude/settings.local.json exists, the git-guard hook is live and probed, and that worktree directory is granted. Do not re-install the hook; verify and continue."

if [ "$LAUNCH" = 0 ]; then
  [ "$DRY" = 1 ] || ok "configured — not launching (--no-launch)"
  cat <<EOF

Start it yourself with:
  cd "$DIR" && claude --add-dir "$WT"

Then say:
  $PROMPT
EOF
  exit 0
fi

ok "starting Claude Code in $DIR"
cd "$DIR"
exec claude --add-dir "$WT" "$PROMPT"
